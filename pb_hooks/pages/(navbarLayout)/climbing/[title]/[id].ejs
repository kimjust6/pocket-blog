<script server>
    const { handleSinglePostRoute } = require(`${__hooks}/pages/utils/common.js`)
    const reqObj = typeof request !== 'undefined' ? request : null
    const { isListView, isCanonicalPost, singleBlogView } = handleSinglePostRoute(true, params, data, reqObj, api, redirect)
</script>

<% if (isListView) { %>
    <%- include('blogcards.ejs', { isClimbing: true }) %>
<% } else if (isCanonicalPost && singleBlogView) { %>
    <%- include('blogpage.ejs', { isClimbing: true, singleBlog: singleBlogView.rawBlog, blogView: singleBlogView }) %>
<% } else { %>
    <%- include('pagenotfound.ejs') %>
<% } %>
