<script server>
    const { prepareBlogSingleViewData } = resolve('../../utils/common')
    const reqObj = typeof request !== 'undefined' ? request : null
    const singleBlogView = prepareBlogSingleViewData(null, true, params, data, reqObj)
</script>

<% if (typeof(params.title) === "undefined") { %>
    <%- include('../../_private/blogcards.ejs', { isClimbing: true }) %>
<% } else { %>
    <% if (singleBlogView == null) { %>
        <%- include('../../_private/pagenotfound.ejs') %>
    <% } else { %>
        <%- include('../../_private/blogpage.ejs', { isClimbing: true, singleBlog: singleBlogView.rawBlog }) %>
    <% } %>
<% } %>

