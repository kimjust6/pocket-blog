<script type="module">
    import { createApp } from '/js/petite-vue.es.js'
    // import pocketbase from 'https://cdn.jsdelivr.net/npm/pocketbase@0.26.2/+esm'
    // const myPB = new pocketbase('http://127.0.0.1:8090');

    const Constants = {
        sitename: 'The Justin Blog',
        navigation: [
            { title: 'Posts', url: '/blog/posts' },
            { title: 'FAQ', url: '/faq' },
            { title: 'Privacy', url: '/privacy' },
            { title: 'Terms', url: '/terms' },
        ],
    }

    function Pocket() {
        return {
            // getBlogPosts() {
            //     if (!myPB) {
            //         myPB = new pocketbase('http://127.0.0.1:8090');
            //     }
            //     myPB.collection('blogposts').getList(1, 50).then((result) => {
            //         console.log(result);
            //         return result;
            //     }).catch((error) => {
            //         console.log(error);
            //     })
            // }
        }
    }

    function ThemeToggle() {
        return {
            theme: localStorage.getItem('theme') || 'dark',
            mounted() {
                document.documentElement.setAttribute('data-theme', this.theme)
                // Add or remove 'dark' class for Tailwind dark mode
                if (this.theme === 'dark') {
                    document.documentElement.classList.add('dark')
                } else {
                    document.documentElement.classList.remove('dark')
                }
            },
            toggleTheme() {
                this.theme = this.theme === 'dark' ? 'nord' : 'dark'
                document.documentElement.setAttribute('data-theme', this.theme)
                localStorage.setItem('theme', this.theme)
                // Toggle 'dark' class for Tailwind dark mode
                if (this.theme === 'dark') {
                    document.documentElement.classList.add('dark')
                } else {
                    document.documentElement.classList.remove('dark')
                }
            },
        }
    }

    function NavigationMenu() {
        return {
            isOpen: false,
            toggle() {
                this.isOpen = !this.isOpen
            },
            close() {
                this.isOpen = false
            },
        }
    }

    createApp({
        Constants,
        ThemeToggle,
        NavigationMenu,
    }).mount()

    // Enable View Transitions API for blog navigation
    if ('startViewTransition' in document) {
        // Intercept blog-related navigation for smooth transitions
        document.addEventListener('click', (e) => {
            const link = e.target.closest('a[href*="/blog/posts"]')
            if (link && !e.ctrlKey && !e.metaKey && !e.shiftKey) {
                e.preventDefault()
                document.startViewTransition(() => {
                    window.location.href = link.href
                })
            }
        })

        // Handle back navigation with view transitions
        window.addEventListener('popstate', (e) => {
            if ('startViewTransition' in document) {
                document.startViewTransition(() => {
                    window.location.reload()
                })
            }
        })
    }
</script>

<!doctype html>
<html lang="en" data-theme="nord" v-scope="Constants">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <script>
            // Set theme before page renders to prevent flash
            ;(function () {
                const theme = localStorage.getItem('theme') || 'dark'
                document.documentElement.setAttribute('data-theme', theme)
                // Add 'dark' class for Tailwind dark mode
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark')
                } else {
                    document.documentElement.classList.remove('dark')
                }
            })()
        </script>

        <% data.metadata.forEach(function(ogTag) { %>
        <meta name="<%= ogTag.name %>" content="<%= ogTag.content %>" />
        <% }); %>

        <title>
            <%= data.metadata.find(x => x.name === 'title')?.content %>
        </title>
        <link href="<%=asset('/app.css')%>" rel="stylesheet" />
        <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    </head>
    <body class="relative overflow-x-hidden">
        <div
            class="pointer-events-none fixed inset-0 -z-20 bg-gradient-to-b from-primary/10 via-base-100/40 to-base-100/80"
        ></div>
        <div class="fixed inset-0 -z-10 grid-overlay opacity-40"></div>
        <div class="page-shell">
            <header
                class="fixed inset-x-0 top-0 z-40 px-4 sm:px-6 lg:px-10"
                v-scope="NavigationMenu()"
            >
                <div class="mx-auto max-w-6xl">
                    <div class="glass-panel border border-white/10 px-5 py-3">
                        <div
                            class="flex items-center justify-between gap-4 text-sm font-medium uppercase tracking-[0.2em]"
                        >
                            <div class="flex items-center gap-3">
                                <a
                                    href="/"
                                    class="no-underline text-base font-semibold normal-case tracking-tight"
                                >
                                    {{ Constants.sitename }}
                                </a>
                            </div>
                            <div
                                class="hidden items-center gap-1 text-xs font-semibold lg:flex"
                            >
                                <a
                                    v-for="(item, index) in Constants.navigation"
                                    :key="index"
                                    :href="item.url"
                                    class="feature-pill transition hover:text-primary"
                                >
                                    {{ item.title }}
                                </a>
                            </div>
                            <div class="hidden items-center gap-3 lg:flex">
                                <a
                                    href="/blog/posts"
                                    class="btn btn-sm btn-primary"
                                    >Latest Posts</a
                                >
                                <div
                                    class="flex-none"
                                    v-scope="ThemeToggle()"
                                    @vue:mounted="mounted"
                                >
                                    <button
                                        @click="toggleTheme"
                                        class="btn btn-ghost btn-circle border border-white/10 bg-base-100/60"
                                    >
                                        <svg
                                            v-if="theme === 'nord'"
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            class="inline-block h-5 w-5 stroke-blue-300"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                                            ></path>
                                        </svg>
                                        <svg
                                            v-else
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            class="inline-block h-5 w-5 stroke-yellow-200"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                                            ></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 lg:hidden">
                                <a
                                    href="/blog/posts"
                                    class="btn btn-xs btn-primary"
                                    >Posts</a
                                >
                                <button
                                    @click="toggle"
                                    class="btn btn-ghost btn-square btn-sm border border-white/10"
                                >
                                    <span v-if="!isOpen">Menu</span>
                                    <span v-else>Close</span>
                                </button>
                            </div>
                        </div>
                        <div
                            v-show="isOpen"
                            class="mt-4 flex flex-col gap-4 lg:hidden"
                        >
                            <div
                                class="glass-panel border border-white/5 px-4 py-4"
                            >
                                <div
                                    class="flex flex-col gap-3 text-sm uppercase"
                                >
                                    <a
                                        v-for="(item, index) in Constants.navigation"
                                        :key="index"
                                        :href="item.url"
                                        class="feature-pill text-center"
                                        @click="close"
                                        >{{ item.title }}</a
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div
                    v-show="isOpen"
                    class="fixed inset-0 z-30 bg-base-300/60 backdrop-blur-sm lg:hidden"
                    @click="close"
                ></div>
            </header>
            <main class="relative flex-1 pt-28 pb-16">
                <div class="relative z-10 px-4 sm:px-6 lg:px-10">
                    <%- slot %>
                </div>
            </main>
            <%- include('footer.ejs') %>
        </div>
    </body>
</html>
