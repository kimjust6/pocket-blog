<!doctype html>
<html
    lang="en"
    data-theme="<%= data.theme %>"
    class="<%= data.theme === 'dark' ? 'dark' : '' %>"
>
    <head>
        <script>
            (function () {
                try {
                    var match = document.cookie.match(/(^|;)\s*theme=([^;]+)/);
                    var saved = match ? match[2] : null;
                    if (!saved) saved = localStorage.getItem('theme');
                    if (saved === 'nord' || saved === 'dark') {
                        document.documentElement.setAttribute('data-theme', saved);
                        if (saved === 'dark') {
                            document.documentElement.classList.add('dark');
                        } else {
                            document.documentElement.classList.remove('dark');
                        }
                    }
                } catch (_) {}
            })();
        </script>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            http-equiv="Content-Security-Policy"
            content="
                default-src 'self';
                script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.youtube.com https://youtube.com https://*.ytimg.com https://unpkg.com https://www.googletagmanager.com https://www.google.com https://cdnjs.cloudflare.com;
                frame-src 'self' https://*.youtube.com https://youtube.com https://*.youtube-nocookie.com;
                img-src 'self' data: blob: https://*.ytimg.com https://*.youtube.com https://*.ggpht.com https://www.google.com https://www.googletagmanager.com;
                connect-src 'self' https://*.youtube.com https://youtubei.googleapis.com https://yt3.ggpht.com https://www.google-analytics.com https://www.googletagmanager.com;
                media-src 'self' blob: https://*.youtube.com https://*.googlevideo.com;
                style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com;
                font-src 'self' data: https://cdnjs.cloudflare.com;
                worker-src 'self' blob:;
            "
        />

        <% data.metadata.forEach(function(ogTag) { %>
            <% if (ogTag && ogTag.content) { %>
                <% if (ogTag.name.startsWith('og:') || ogTag.name.startsWith('article:')) { %>
        <meta property="<%= ogTag.name %>" content="<%= ogTag.content %>" />
                <% } else { %>
        <meta name="<%= ogTag.name %>" content="<%= ogTag.content %>" />
                <% } %>
            <% } %>
        <% }); %>

        <title><%= data.metadata.find(x => x.name === 'title')?.content || 'The Justin Blog' %></title>
        <% const canonicalUrl = data.metadata.find(x => x.name === 'og:url' || x.name === 'url')?.content; %>
        <% if (canonicalUrl) { %>
        <link rel="canonical" href="<%= canonicalUrl %>" />
        <% } %>

        <!-- Mobile & Browser Theme Color -->
        <meta name="theme-color" content="#2D6392" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0f141c" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#0f141c" />

        <!-- Favicons & App Icons -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
        <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- Styles & Preconnects -->
        <link href="<%=asset('/app.css')%>" rel="stylesheet" />
        <link rel="preconnect" href="https://unpkg.com" crossorigin />
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

        <!-- Structured Data (JSON-LD) -->
        <%
            const metaGet = (key) => (data.metadata || []).find(m => m.name === key)?.content;
            const isArticle = metaGet('og:type') === 'article';
            const pageCanonical = metaGet('og:url') || metaGet('url') || 'https://www.jkim.win/';
            const pageTitle = metaGet('og:title') || metaGet('title') || 'The Justin Blog';
            const pageDesc = metaGet('og:description') || metaGet('description') || 'Keeping a personal record of my mistakes and lessons learned as a developer.';
            const pageImg = metaGet('og:image') || 'https://www.jkim.win/og-image.png';

            let jsonLd;
            if (isArticle) {
                jsonLd = {
                    "@context": "https://schema.org",
                    "@type": "BlogPosting",
                    "mainEntityOfPage": {
                        "@type": "WebPage",
                        "@id": pageCanonical
                    },
                    "headline": pageTitle,
                    "description": pageDesc,
                    "image": [pageImg],
                    "author": {
                        "@type": "Person",
                        "name": metaGet('author') || "Justin Kim",
                        "url": metaGet('article:author') || "https://www.justink.dev"
                    },
                    "publisher": {
                        "@type": "Person",
                        "name": "Justin Kim",
                        "url": "https://www.justink.dev"
                    }
                };
                const pubTime = metaGet('article:published_time');
                if (pubTime) jsonLd.datePublished = pubTime;
                const modTime = metaGet('article:modified_time') || pubTime;
                if (modTime) jsonLd.dateModified = modTime;
                const keywords = metaGet('keywords');
                if (keywords) jsonLd.keywords = keywords;
                const section = metaGet('article:section');
                if (section) jsonLd.articleSection = section;
            } else {
                jsonLd = {
                    "@context": "https://schema.org",
                    "@type": "WebSite",
                    "name": "The Justin Blog",
                    "url": pageCanonical,
                    "description": pageDesc,
                    "author": {
                        "@type": "Person",
                        "name": "Justin Kim",
                        "url": "https://www.justink.dev"
                    }
                };
            }
        %>
        <script type="application/ld+json">
<%- JSON.stringify(jsonLd, null, 2) %>
        </script>
        <!-- Speculation Rules API for instant navigation prefetching -->
        <script type="speculationrules">
        {
            "prefetch": [
                {
                    "where": { "href_matches": "/*" },
                    "eagerness": "moderate"
                }
            ]
        }
        </script>
        <script src="https://unpkg.com/petite-vue" defer init></script>
        <script type="module">
            function syncThemeIcons(theme) {
                const currentTheme = theme || document.documentElement.getAttribute('data-theme') || 'dark';
                const sun = document.getElementById('theme-icon-sun');
                const moon = document.getElementById('theme-icon-moon');
                if (sun) sun.style.display = currentTheme === 'dark' ? 'inline-block' : 'none';
                if (moon) moon.style.display = currentTheme === 'nord' ? 'inline-block' : 'none';
            }

            function toggleTheme() {
                const html = document.documentElement;
                const currentTheme = html.getAttribute('data-theme') === 'nord' ? 'nord' : 'dark';
                const newTheme = currentTheme === 'dark' ? 'nord' : 'dark';

                html.setAttribute('data-theme', newTheme);
                try {
                    localStorage.setItem('theme', newTheme);
                } catch (_) {}
                document.cookie = `theme=${newTheme}; path=/; max-age=31536000; SameSite=Lax`;

                if (newTheme === 'dark') {
                    html.classList.add('dark');
                } else {
                    html.classList.remove('dark');
                }

                syncThemeIcons(newTheme);
            }
            window.toggleTheme = toggleTheme;

            // Sync icons on page load and back/forward restore
            syncThemeIcons();
            document.addEventListener('DOMContentLoaded', () => syncThemeIcons());
            window.addEventListener('pageshow', () => syncThemeIcons());

            // Register Service Worker for local caching and offline support
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js').catch((err) => {
                        console.debug('SW registration skipped:', err);
                    });
                });
            }

            // Link hover prefetching for instant page navigation
            const prefetchedUrls = new Set();
            document.addEventListener('pointerenter', (e) => {
                const a = e.target && e.target.closest ? e.target.closest('a') : null;
                if (a && a.href && a.origin === location.origin && !a.hasAttribute('download')) {
                    if (!prefetchedUrls.has(a.href)) {
                        prefetchedUrls.add(a.href);
                        const link = document.createElement('link');
                        link.rel = 'prefetch';
                        link.href = a.href;
                        document.head.appendChild(link);
                    }
                }
            }, { passive: true, capture: true });
        </script>
        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-6P8M4DJNQL"
        ></script>
        <script>
            window.dataLayer = window.dataLayer || []
            function gtag() {
                dataLayer.push(arguments)
            }
            gtag('js', new Date())

            gtag('config', 'G-6P8M4DJNQL', {
                anonymize_ip: true,
                allow_google_signals: false,
                allow_ad_personalization_signals: false,
                cookie_flags: 'SameSite=Lax;Secure'
            })
        </script>
    </head>

    <body class="flex min-h-screen flex-col">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:p-4 focus:bg-primary focus:text-primary-content focus:rounded-md focus:shadow-lg">Skip to main content</a>
        <div class="drawer flex-1">
            <input id="my-drawer-3" type="checkbox" class="drawer-toggle" aria-label="Toggle navigation drawer" />
            <div class="drawer-content flex min-h-full flex-col">
                <!-- Navbar -->
                <%- include('navbar.ejs') %>
                <main id="main-content" tabindex="-1" class="prose max-w-none flex-1 pt-16">
                    <%- slot %>
                </main>
            </div>
            <%- include('sidebar.ejs') %>
        </div>

        <%- include('footer.ejs') %>
    </body>
</html>
