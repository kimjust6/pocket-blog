<!doctype html>
<html
    lang="en"
    data-theme="<%= data.theme %>"
    class="<%= data.theme === 'dark' ? 'dark' : '' %>"
>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            http-equiv="Content-Security-Policy"
            content="
                default-src 'self';
                script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.youtube.com https://youtube.com https://*.ytimg.com https://unpkg.com https://www.googletagmanager.com https://www.google.com https://cdnjs.cloudflare.com;
                frame-src 'self' https://*.youtube.com https://youtube.com https://*.youtube-nocookie.com;
                img-src 'self' data: blob: https://*.ytimg.com https://*.youtube.com https://*.ggpht.com https://www.google.com https://www.googletagmanager.com;
                connect-src 'self' https://*.youtube.com https://youtubei.googleapis.com https://yt3.ggpht.com https://www.google-analytics.com https://www.googletagmanager.com;
                media-src 'self' blob: https://*.youtube.com https://*.googlevideo.com;
                style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com;
                font-src 'self' data: https://cdnjs.cloudflare.com;
                worker-src 'self' blob:;
            "
        />

        <% data.metadata.forEach(function(ogTag) { %>
        <meta name="<%= ogTag.name %>" content="<%= ogTag.content %>" />
        <% }); %>

        <title>
            <%= data.metadata.find(x=> x.name === 'title')?.content %>
        </title>
        <link href="<%=asset('/app.css')%>" rel="stylesheet" />
        <link rel="preconnect" href="https://unpkg.com" crossorigin />
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
        <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
        <script src="https://unpkg.com/petite-vue" defer init></script>
        <script type="module">
            function toggleTheme() {
                const html = document.documentElement
                const currentTheme = html.getAttribute('data-theme')
                const newTheme = currentTheme === 'dark' ? 'nord' : 'dark'

                html.setAttribute('data-theme', newTheme)
                document.cookie = `theme=${newTheme}; path=/; max-age=31536000; SameSite=Lax`

                if (newTheme === 'dark') {
                    html.classList.add('dark')
                } else {
                    html.classList.remove('dark')
                }

                document.getElementById('theme-icon-sun').style.display =
                    newTheme === 'nord' ? 'inline-block' : 'none'
                document.getElementById('theme-icon-moon').style.display =
                    newTheme === 'dark' ? 'inline-block' : 'none'
            }
            window.toggleTheme = toggleTheme

            if ('startViewTransition' in document) {
                document.addEventListener('click', (e) => {
                    const link = e.target.closest(
                        'a[href*="/blog/posts"], a[href*="/climbing"]'
                    )
                    if (link && !e.ctrlKey && !e.metaKey && !e.shiftKey) {
                        e.preventDefault()
                        document.startViewTransition(() => {
                            window.location.href = link.href
                        })
                    }
                })

                window.addEventListener('popstate', () => {
                    document.startViewTransition(() => {
                        window.location.reload()
                    })
                })
            }
        </script>
        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-6P8M4DJNQL"
        ></script>
        <script>
            window.dataLayer = window.dataLayer || []
            function gtag() {
                dataLayer.push(arguments)
            }
            gtag('js', new Date())

            gtag('config', 'G-6P8M4DJNQL', {
                anonymize_ip: true,
                allow_google_signals: false,
                allow_ad_personalization_signals: false,
                cookie_flags: 'SameSite=Lax;Secure'
            })
        </script>
    </head>

    <body class="flex min-h-screen flex-col">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:p-4 focus:bg-primary focus:text-primary-content focus:rounded-md focus:shadow-lg">Skip to main content</a>
        <div class="drawer flex-1">
            <input id="my-drawer-3" type="checkbox" class="drawer-toggle" aria-label="Toggle navigation drawer" />
            <div class="drawer-content flex min-h-full flex-col">
                <!-- Navbar -->
                <%- include('navbar.ejs') %>
                <main id="main-content" tabindex="-1" class="prose max-w-none flex-1 pt-16">
                    <%- slot %>
                </main>
            </div>
            <%- include('sidebar.ejs') %>
        </div>

        <%- include('footer.ejs') %>
    </body>
</html>
