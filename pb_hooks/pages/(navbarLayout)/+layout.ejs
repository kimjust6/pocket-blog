<!doctype html>
<html
    lang="en"
    data-theme="<%= data.theme %>"
    class="<%= data.theme === 'dark' ? 'dark' : '' %>"
>
    <head>
        <script>
            (function () {
                try {
                    var match = document.cookie.match(/(^|;)\s*theme=([^;]+)/);
                    var saved = match ? match[2] : null;
                    if (!saved) saved = localStorage.getItem('theme');
                    if (saved === 'nord' || saved === 'dark') {
                        document.documentElement.setAttribute('data-theme', saved);
                        if (saved === 'dark') {
                            document.documentElement.classList.add('dark');
                        } else {
                            document.documentElement.classList.remove('dark');
                        }
                    }
                } catch (_) {}
            })();
        </script>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            http-equiv="Content-Security-Policy"
            content="
                default-src 'self';
                script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.youtube.com https://youtube.com https://*.ytimg.com https://www.googletagmanager.com https://www.google.com https://cdnjs.cloudflare.com;
                frame-src 'self' https://*.youtube.com https://youtube.com https://*.youtube-nocookie.com;
                img-src 'self' data: blob: https://*.ytimg.com https://*.youtube.com https://*.ggpht.com https://www.google.com https://www.googletagmanager.com;
                connect-src 'self' https://*.youtube.com https://youtubei.googleapis.com https://yt3.ggpht.com https://www.google-analytics.com https://www.googletagmanager.com;
                media-src 'self' blob: https://*.youtube.com https://*.googlevideo.com;
                style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com;
                font-src 'self' data: https://cdnjs.cloudflare.com;
                worker-src 'self' blob:;
            "
        />

        <% data.metadata.forEach(function(ogTag) { %>
            <% if (ogTag && ogTag.content) { %>
                <% if (ogTag.name.startsWith('og:') || ogTag.name.startsWith('article:')) { %>
        <meta property="<%= ogTag.name %>" content="<%= ogTag.content %>" />
                <% } else { %>
        <meta name="<%= ogTag.name %>" content="<%= ogTag.content %>" />
                <% } %>
            <% } %>
        <% }); %>

        <title><%= data.metadata.find(x => x.name === 'title')?.content || data.siteName %></title>
        <% const canonicalUrl = data.metadata.find(x => x.name === 'og:url' || x.name === 'url')?.content; %>
        <% if (canonicalUrl) { %>
        <link rel="canonical" href="<%= canonicalUrl %>" />
        <% } %>

        <!-- Feeds & Sitemaps -->
        <link rel="alternate" type="application/rss+xml" title="<%= data.siteName %> RSS Feed" href="/rss.xml" />
        <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

        <!-- Mobile & Browser Theme Color -->
        <meta name="application-name" content="<%= data.siteName %>" />
        <meta name="apple-mobile-web-app-title" content="<%= data.siteName %>" />
        <meta name="theme-color" content="#2D6392" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0f141c" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#0f141c" />

        <!-- Favicons & App Icons -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
        <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- Styles & Preconnects -->
        <link href="<%=asset('/app.css')%>" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" integrity="sha512-vswe+cgvic/XBoF1OcM/TeJ2FW0OofqAVdCZiEYkd6dwGXthvkSFWOoGGJgS2CW70VK5dQM5Oh+7ne47s74VTg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

        <!-- Structured Data (JSON-LD) -->
        <%
            const { buildJsonLdGraph } = require(`${__hooks}/pages/utils/common.js`);
            const jsonLd = buildJsonLdGraph(data);
        %>
        <script type="application/ld+json">
<%- JSON.stringify(jsonLd, null, 2).replace(/</g, '\\u003c') %>
        </script>
        <script id="app-config-data" type="application/json"><%- JSON.stringify({
            siteName: data.siteName,
            currentYear: new Date().getFullYear(),
            navigation: data.navigation || [],
            socials: data.socials || []
        }).replace(/</g, '\\u003c') %></script>
        <% if (typeof data !== 'undefined' && data.initialRouteData) { %>
        <script id="initial-route-data" type="application/json"><%- JSON.stringify(data.initialRouteData).replace(/</g, '\\u003c') %></script>
        <% } %>
        <script src="/js/vue.global.prod.js" defer></script>
        <script src="/js/vue-router.global.prod.js" defer></script>
        <script src="/js/components.js?v=10" defer></script>
        <script src="/js/app.js?v=10" defer></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" defer></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js" defer></script>
        <script type="module">
            function syncThemeIcons(theme) {
                const currentTheme = theme || document.documentElement.getAttribute('data-theme') || 'dark';
                const sun = document.getElementById('theme-icon-sun');
                const moon = document.getElementById('theme-icon-moon');
                if (sun) sun.style.display = currentTheme === 'dark' ? 'inline-block' : 'none';
                if (moon) moon.style.display = currentTheme === 'nord' ? 'inline-block' : 'none';
            }

            function toggleTheme() {
                const html = document.documentElement;
                const currentTheme = html.getAttribute('data-theme') === 'nord' ? 'nord' : 'dark';
                const newTheme = currentTheme === 'dark' ? 'nord' : 'dark';

                html.setAttribute('data-theme', newTheme);
                try {
                    localStorage.setItem('theme', newTheme);
                } catch (_) {}
                document.cookie = `theme=${newTheme}; path=/; max-age=31536000; SameSite=Lax`;

                if (newTheme === 'dark') {
                    html.classList.add('dark');
                } else {
                    html.classList.remove('dark');
                }

                syncThemeIcons(newTheme);
                window.dispatchEvent(new CustomEvent('theme-change', { detail: newTheme }));
                return newTheme;
            }
            window.toggleTheme = toggleTheme;

            // Sync icons on page load and back/forward restore
            syncThemeIcons();
            document.addEventListener('DOMContentLoaded', () => syncThemeIcons());
            window.addEventListener('pageshow', () => syncThemeIcons());

            // Register Service Worker for local caching and offline support
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js').catch((err) => {
                        console.debug('SW registration skipped:', err);
                    });
                });
            }
        </script>
        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=<%= data.gaMeasurementId %>"
        ></script>
        <script>
            window.dataLayer = window.dataLayer || []
            function gtag() {
                dataLayer.push(arguments)
            }
            gtag('js', new Date())

            gtag('config', '<%= data.gaMeasurementId %>', {
                anonymize_ip: true,
                allow_google_signals: false,
                allow_ad_personalization_signals: false,
                cookie_flags: 'SameSite=Lax;Secure'
            })
        </script>
    </head>

    <body class="flex min-h-screen flex-col">
        <div id="app" class="flex min-h-screen flex-col">
            <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:p-4 focus:bg-primary focus:text-primary-content focus:rounded-md focus:shadow-lg">Skip to main content</a>
            <div class="drawer flex-1">
                <input id="my-drawer-3" type="checkbox" class="drawer-toggle" aria-label="Toggle navigation drawer" />
                <div class="drawer-content flex min-h-full flex-col">
                    <!-- Navbar -->
                    <%- include('navbar.ejs') %>
                    <main id="main-content" tabindex="-1" class="prose max-w-none flex-1 pt-16">
                        <%- slot %>
                    </main>
                </div>
                <%- include('sidebar.ejs') %>
            </div>

            <%- include('footer.ejs') %>
        </div>
    </body>
</html>
