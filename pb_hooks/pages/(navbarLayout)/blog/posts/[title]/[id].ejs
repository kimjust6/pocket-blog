<script server>
    const { prepareBlogSingleViewData, slugifyTitle } = require(`${__hooks}/pages/utils/common.js`)
    const reqObj = typeof request !== 'undefined' ? request : null

    const isListView = !params.id && (!params.title || params.title === 'index')
    const isLegacyPost = !params.id && params.title && params.title !== 'index'
    const isCanonicalPost = Boolean(params.id)

    let viewForRedirect = null
    let singleBlogView = null

    if (isLegacyPost) {
        // Old-format URL: /blog/posts/:slug → 301 redirect to /blog/posts/:slug/:id
        viewForRedirect = prepareBlogSingleViewData(null, false, params, data, reqObj)
        if (viewForRedirect && viewForRedirect.rawBlog) {
            const rawBlog = viewForRedirect.rawBlog
            const newSlug = slugifyTitle(rawBlog.getString('title'))
            redirect(`/blog/posts/${encodeURIComponent(newSlug)}/${rawBlog.id}`, 301)
        }
    } else if (isCanonicalPost) {
        // Canonical URL: /blog/posts/:slug/:id
        singleBlogView = prepareBlogSingleViewData(null, false, params, data, reqObj)
    }
</script>

<% if (isListView) { %>
    <%- include('blogcards.ejs') %>
<% } else if (isCanonicalPost) { %>
    <% if (singleBlogView == null) { %>
        <%- include('pagenotfound.ejs') %>
    <% } else { %>
        <%- include('blogpage.ejs', { isClimbing: false, singleBlog: singleBlogView.rawBlog }) %>
    <% } %>
<% } else { %>
    <%- include('pagenotfound.ejs') %>
<% } %>
