<script server>
  const { getAllBlogPosts } = resolve('../utils/pocket')
  const blogposts = getAllBlogPosts("-created")

  const buildDate = new Date().toUTCString()
  const description = "The Justin Blog - Thoughts on tech, life, and everything in between."

  const items = blogposts.map(post => {
    const pubDate = new Date(post.getString('manualPublishDate') || post.getString('created')).toUTCString()
    const postLink = `https://www.jkim.win/blog/posts/${post.id}`
    const content1 = post.getString('content1') || ''
    const content2 = post.getString('content2') || ''
    const postDesc = content1
      .replace(/<[^>]*>/g, '') // Strip HTML
      .substring(0, 300) // Truncate
      + (content1.length > 300 ? '...' : '')

    const fullContent = content1 + content2

    return `
    <item>
      <title><![CDATA[${post.getString('title')}]]></title>
      <link>${postLink}</link>
      <guid>${postLink}</guid>
      <pubDate>${pubDate}</pubDate>
      <description><![CDATA[${postDesc}]]></description>
      <content:encoded><![CDATA[${fullContent}]]></content:encoded>
    </item>`
  }).join('')

  const rss = `<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>The Justin Blog</title>
    <link>https://www.jkim.win</link>
    <description>${description}</description>
    <language>en-us</language>
    <lastBuildDate>${buildDate}</lastBuildDate>
    <atom:link href="https://www.jkim.win/rss.xml" rel="self" type="application/rss+xml" />
    ${items}
  </channel>
</rss>`

  response.header('Content-Type', 'application/xml')
  response.write(rss)
</script>