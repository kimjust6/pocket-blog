<script server>
  const { getSitemapData, escapeXml } = require(`${__hooks}/pages/utils/common.js`)
  const sitemapData = getSitemapData()
  const postsBlog = typeof blogposts !== 'undefined' ? blogposts : sitemapData.blogposts
  const postsClimb = typeof climbingposts !== 'undefined' ? climbingposts : sitemapData.climbingposts
  const toSlug = typeof slugifyTitle !== 'undefined' ? slugifyTitle : sitemapData.slugifyTitle
  const siteBaseUrl = sitemapData.baseUrl

  response.header('Content-Type', 'application/xml; charset=utf-8')

  const latestBlogUpdate = (postsBlog && postsBlog.length > 0)
    ? (new Date(postsBlog[0].getString('updated')).toISOString().split('.')[0] + 'Z')
    : (new Date().toISOString().split('.')[0] + 'Z')

  const latestClimbingUpdate = (postsClimb && postsClimb.length > 0)
    ? (new Date(postsClimb[0].getString('updated') || postsClimb[0].getString('date')).toISOString().split('.')[0] + 'Z')
    : (new Date().toISOString().split('.')[0] + 'Z')

  const staticPages = [
    { loc: `${siteBaseUrl}/`,           lastmod: latestBlogUpdate,     priority: '1.00', changefreq: 'weekly' },
    { loc: `${siteBaseUrl}/blog/posts`, lastmod: latestBlogUpdate,     priority: '0.90', changefreq: 'daily'  },
    { loc: `${siteBaseUrl}/climbing`,   lastmod: latestClimbingUpdate, priority: '0.90', changefreq: 'daily'  },
  ]

  const renderUrl = ({ loc, lastmod, changefreq, priority }) =>
    `<url>
    <loc>${escapeXml(loc)}</loc>
    <lastmod>${escapeXml(lastmod)}</lastmod>
    <changefreq>${escapeXml(changefreq)}</changefreq>
    <priority>${escapeXml(priority)}</priority>
  </url>`

  const xmlStaticPages = staticPages.map(renderUrl).join('\n  ')

  const xmlBlogposts = (postsBlog || [])
    .map((post) =>
      renderUrl({
        loc: `${siteBaseUrl}/blog/posts/${encodeURIComponent(toSlug(post?.getString('title')))}/${post?.id}`,
        lastmod: new Date(post?.getString('updated')).toISOString().split('.')[0] + 'Z',
        changefreq: 'weekly',
        priority: '0.80',
      })
    )
    .join('\n  ')

  const xmlClimbingposts = (postsClimb || [])
    .map((post) =>
      renderUrl({
        loc: `${siteBaseUrl}/climbing/${encodeURIComponent(toSlug(post?.getString('title')))}/${post?.id}`,
        lastmod: new Date(post?.getString('updated') || post?.getString('date')).toISOString().split('.')[0] + 'Z',
        changefreq: 'weekly',
        priority: '0.70',
      })
    )
    .join('\n  ')

  const xmlSnippet = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  ${xmlStaticPages}
  ${xmlBlogposts}
  ${xmlClimbingposts}
</urlset>`

  response.write(xmlSnippet)
</script>
