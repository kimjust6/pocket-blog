                                    (currentPage===i) { %>aria-current="page"<% } %> aria-label="Page <%= i %>">
                                            <%= i %>
                                </a>
                                <% } %>

                                    <% if (currentPage>= totalPages) { %>
                                        <button class="join-item btn btn-sm btn-disabled" aria-label="Next page"
                                            disabled aria-disabled="true">»</button>
                                        <% } else { %>
                                            <a href="?page=<%= currentPage + 1 %><%= fullParams %>"
                                                class="join-item btn btn-sm" aria-label="Next page">»</a>
                                            <% } %>
            </div>
        </nav>
        <% } %>
</div>