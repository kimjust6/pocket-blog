                                                                                    class="badge bg-base-100/60 backdrop-blur-md border border-accent/30 shadow-md text-base-content badge-sm text-nowrap h-auto">
                                                                                    <%= badge.text %>
                                                                                </span>
                                                                                <% }); %>
                                                                        </div>
                                                                        <p
                                                                            class="text-sm text-base-content line-clamp-3">
                                                                            <%= blog.previewText %>
