<script server>
    const { formatDateTime, getImageUrl, slugifyTitle, prepareBlogPostsViewData } = resolve('../../utils/common')
    const { getBlogPosts, getClimbingLogs } = resolve('../../utils/pocket')

    if (typeof isHomepage === 'undefined') {
        var isHomepage = false
    }
    if (typeof isClimbing === 'undefined') {
        var isClimbing = false
    }
    const currentPage = parseInt(params?.page) || 1
    const perPage = params?.perPage ?? (isHomepage ? 7 : 6)

    const rawBlogPosts = isClimbing
        ? (getClimbingLogs(currentPage, perPage, params.query, params.climbType) ?? { items: [], totalPages: 1 })
        : (getBlogPosts(currentPage, perPage, params.query) ?? { items: [], totalPages: 1 })
    const totalPages = rawBlogPosts?.totalPages || 1

    const reqObj = typeof request !== 'undefined' ? request : null
    const {
        hasSearchQuery,
        heroPost,
        gridPosts,
        hasPosts,
        hasNoSearchResults,
        fullParams
    } = prepareBlogPostsViewData(rawBlogPosts, isHomepage, isClimbing, params, reqObj)
</script>

<script>
    var SearchApp = {
        searchQuery: decodeURIComponent('<%- encodeURIComponent(params?.query || "").replace(/\'/g, "%27") %>'),
        hasQuery: ('<%= !!params?.query %>' === 'true'),
        handleSearch() {
            // Update query params in URL
            window.location.href = `?query=${encodeURIComponent(this.searchQuery)}`
        },
        clearSearch() {
            this.searchQuery = ''
            if (this.$refs.searchInput) {
                this.$refs.searchInput.focus()
            }
            if (this.hasQuery) {
                window.location.href = window.location.pathname.startsWith('/climbing') ? '/climbing' : '/blog/posts'
            }
        },
        mounted() {
            if (this.$refs.searchInput) {
                this.$refs.searchInput.focus()
            }
        },
    }
</script>

<div
    class="bg-base-100 pt-16 flex flex-col justify-between <%= !isHomepage ? 'min-h-[calc(100vh-12.54rem)]' : 'pb-12' %>">
    <div class="max-w-6xl mx-auto px-4" v-scope="SearchApp" @vue:mounted="mounted">
        <div class="text-center">

            <% if (!isHomepage) { %>
                <a href="<%= isClimbing ? '/climbing' : '/blog/posts' %>" class="no-underline">
                    <div class="mt-12 mb-6 text-center">
                        <h1 class="text-5xl font-bold">
                            <% if (isClimbing) { %>
                                The Climbing Blog
                            <% } else { %>
                                The Development Blog
                            <% } %>
                        </h1>
                    </div>
                </a>
                <p class="mt-8 text-lg text-base-content">
                    <%= isClimbing ? 'A personal record of sends, failures, and hard-fought projects on the rock and in the gym.' : 'Explore recent insights, retrospectives, and stories.' %>
                </p>
                <div class="flex justify-center">
                    <div class="relative w-full max-w-xl">
                        <input autofocus v-model="searchQuery" ref="searchInput"
                            class="input w-full border border-gray-600 pr-10" placeholder="<%= isClimbing ? 'Search climbs or locations...' : 'Search blogs...' %>"
                            @keydown.enter="handleSearch" />
                        <button v-show="searchQuery" @click="clearSearch"
                            class="absolute right-3 top-1/2 !-translate-y-1/2 btn btn-ghost btn-sm btn-circle active:!-translate-y-1/2"
                            type="button" aria-label="Clear search">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                </div>
                <% if (!hasSearchQuery) { %>
                    <!-- Back to Posts Button -->
                    <div class="my-8 w-full">
                        <div class="flex justify-end w-full">
                            <a href="/" class="btn btn-outline btn-sm gap-2 transition-all duration-200">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="m12 19-7-7 7-7" />
                                    <path d="M19 12H5" />
                                </svg>
                                Back Home
                            </a>
                        </div>
                    </div>
                    <% } %>
                        <% } %>
        </div>

            <% if (heroPost) { 
                const heroText = heroPost.getString('content1').replace(/<[^>]*>/g, '');
                const heroImageUrl = getImageUrl(heroPost) ? `${getImageUrl(heroPost)}?thumb=800x0` : heroPost.getString('coverImageAlt');
            %>
                <!-- Hero Post -->
                <div class="mb-24">
                    <a href="/blog/posts/<%= encodeURIComponent(slugifyTitle(heroPost.getString('title'))) %>"
                        class="no-underline group"
                        onclick="if(window.gtag) window.gtag('event', 'click', { event_category: 'blog_post', event_label: decodeURIComponent('<%= encodeURIComponent(heroPost.getString(`title`)) %>') })">
                        <div class="card w-full lg:card-side backdrop-blur-md shadow-2xl lg:shadow-xl transition-shadow duration-300 blog-card-transition overflow-hidden rounded-xl bg-base-300 relative"
                            style="--blog-card-id: blog-card-<%= heroPost.id %>">
                            <span
                                class="absolute py-1 px-2 sm:py-2 sm:px-4 bg-base-100/60 backdrop-blur-md border border-white/20 shadow-lg text-base-content text-xs md:text-sm lg:text-base font-semibold uppercase tracking-wide z-10 rounded-full"
                                style="position-anchor: --blog-image; bottom:calc(anchor(bottom) + 0.75rem); left:calc(anchor(left) + 0.75rem); view-transition-name: latest-post-badge">Latest
                                Post</span>
                            <% if (heroImageUrl && heroImageUrl !=="" ) { %>
                                <figure class="lg:w-1/2 h-auto m-0 rounded-t-lg lg:rounded-t-none lg:rounded-l-lg">
                                    <img src="<%= heroImageUrl %>" alt="<%= heroPost.getString('title') %>"
                                        class="w-full h-full object-cover blog-image-transition rounded-t-lg lg:rounded-t-none lg:rounded-l-lg"
                                        style="--blog-image-id: blog-image-<%= heroPost.id %>; anchor-name: --blog-image"
                                        width="610"
                                        height="407"
                                        fetchpriority="high" />
                                </figure>
                                <% } %>
                                    <div class="card-body lg:w-1/2 justify-center blog-body-transition p-8 md:p-12">
                                        <h2 class="card-title text-3xl md:text-4xl font-bold group-hover:text-primary transition-colors duration-200 mt-0 blog-title-transition"
                                            style="--blog-title-id: blog-title-<%= heroPost.id %>">
                                            <%= heroPost.getString('title') %>
                                        </h2>
                                        <div class="flex flex-wrap pb-4 gap-2">
                                            <% const heroTags=heroPost.getString('tags'); if (heroTags &&
                                                heroTags.length> 0) {
                                                heroTags.split(';').forEach(tag => { %>
                                                <span class="badge badge-outline lg:badge-lg text-nowrap">
                                                    <%= tag %>
                                                </span>
                                                <% }) %>
                                                    <% } %>
                                        </div>
                                        <p class="text-lg text-base-content mt-4 line-clamp-4">
                                            <%= heroText %>
                                        </p>
                                        <span class="text-sm text-base-content block">
                                            <%= formatDateTime(new Date(heroPost.getString('manualPublishDate') ||
                                                heroPost.getString('created'))) %>
                                        </span>
                                    </div>
                        </div>
                    </a>
                </div>

                <% } %>
                    <% if (hasNoSearchResults) { %>
                        <div class="mx-auto max-w-xl py-16 text-center">
                            <h1 class="mb-4 text-4xl font-bold">No search results</h1>
                            <p class="mb-6 text-lg text-base-content">
                                <%= isClimbing ? 'No climbing entries' : 'No blog posts' %> matched "<%= params.query %>".
                            </p>
                            <a href="<%= isClimbing ? '/climbing' : '/blog/posts' %>" class="btn btn-primary">Clear Search</a>
                        </div>
                        <% } else { %>
                            <% if (hasSearchQuery) { %>
                                <div class="mb-12 pt-8 text-center">
                                    <p class="mb-4 text-lg text-base-content">Results for
                                        <span class="text-lg text-base-content">"<%= params.query %>"</span>
                                    </p>
                                </div>
                                <% } else { %>
                                    <% if (heroPost) { %>
                                        <a href="<%= isClimbing ? '/climbing' : '/blog/posts' %>" class="no-underline">
                                            <div class="mb-12 text-center">
                                                <h1 class="text-5xl font-bold">
                                                    Older Posts
                                                </h1>
                                            </div>
                                        </a>
                                    <% } %>
                                    <% } %>

                                        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                                            <% gridPosts.forEach((blog, index) => {
                                                const text = (isClimbing ? blog.getString('content') : blog.getString('content1')).replace(/<[^>]*>/g, '');
                                                const myImageUrl = isClimbing 
                                                    ? ((getImageUrl(blog) ? `${getImageUrl(blog)}?thumb=350x0` : '/background.webp'))
                                                    : (getImageUrl(blog) ? `${getImageUrl(blog)}?thumb=350x0` : blog.getString('coverImageAlt')); %>

                                                     <a href="<%= isClimbing ? '/climbing/' : '/blog/posts/' %><%= encodeURIComponent(slugifyTitle(blog.getString('title'))) %>"
                                                         class="no-underline group"
                                                         onclick="if(window.gtag) window.gtag('event', 'click', { event_category: '<%= isClimbing ? `climbing_log` : `blog_post` %>', event_label: decodeURIComponent('<%= encodeURIComponent(blog.getString(`title`)) %>') })">
                                                         <div class="card bg-base-300 backdrop-blur-md shadow-xl transition-shadow duration-300 blog-card-transition"
                                                             style="--blog-card-id: blog-card-<%= blog.id %>">
                                                              <% if (myImageUrl !==null && myImageUrl !=="" ) { %>
                                                                 <figure
                                                                     class="h-auto md:h-48 overflow-hidden m-0 rounded-t-lg">
                                                                     <% const isLcp = (!isHomepage && index === 0); %>
                                                                     <img src="<%= myImageUrl%>"
                                                                         alt="<%= blog.getString('title') %>"
                                                                         class="w-full h-auto md:h-48 object-cover blog-image-transition rounded-t-lg"
                                                                         style="--blog-image-id: blog-image-<%= blog.id %>"
                                                                         width="350"
                                                                         height="192"
                                                                         <%= isLcp ? 'fetchpriority="high"' : 'loading="lazy"' %> />
                                                                 </figure>
                                                                 <% } %>
                                                                     <div
                                                                         class="card-body p-8 gap-0 blog-body-transition">
                                                                         <div class="flex flex-wrap gap-2 pb-4">
                                                                             <% if (isClimbing) { %>
                                                                                 <span class="badge badge-outline badge-sm text-nowrap h-auto">
                                                                                     <%= blog.getString('climbType') %>
                                                                                 </span>
                                                                                 <% if (blog.getString('grade')) { %>
                                                                                     <span class="badge badge-outline badge-sm text-nowrap h-auto">
                                                                                         <%= blog.getString('grade') %>
                                                                                     </span>
                                                                                 <% } %>
                                                                                 <% if (blog.getString('style')) { %>
                                                                                     <span class="badge badge-outline badge-sm text-nowrap h-auto">
                                                                                         <%= blog.getString('style') %>
                                                                                     </span>
                                                                                 <% } %>
                                                                             <% } else { %>
                                                                                 <% const blogTags=blog.getString('tags'); if
                                                                                     (blogTags && blogTags.length> 0) {
                                                                                     blogTags.split(';').forEach(tag => { %>
                                                                                     <span
                                                                                         class="badge badge-outline badge-sm text-nowrap h-auto">
                                                                                         <%= tag %>
                                                                                     </span>
                                                                                     <% }) %>
                                                                                 <% } %>
                                                                             <% } %>
                                                                         </div>
                                                                         <h2 class="card-title group-hover:text-primary transition-colors duration-200 mt-0 blog-title-transition"
                                                                             style="--blog-title-id: blog-title-<%= blog.id %>">
                                                                             <%= blog.getString('title') %>
                                                                         </h2>
                                                                         <% if (isClimbing && blog.getString('location')) { %>
                                                                             <div class="flex items-center gap-1 text-xs text-base-content mb-2">
                                                                                 <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                                                                                     <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                                                                 </svg>
                                                                                 <%= blog.getString('location') %>
                                                                             </div>
                                                                         <% } %>
                                                                         <p
                                                                             class="text-sm text-base-content line-clamp-3">
                                                                             <%= text %>
                                                                         </p>
                                                                         <span class="text-xs text-base-content mt-2">
                                                                             <%= formatDateTime(new Date(isClimbing ? blog.getString('date') : (blog.getString('manualPublishDate') || blog.getString('created')))) %>
                                                                         </span>
                                                                     </div>
                                                         </div>
                                                     </a>
                                                     <% }) %>
                                        </div>
                                        <% } %>
    </div>
    <% if (!isHomepage && !hasNoSearchResults) { %>
        <!-- Pagination -->
        <div class="flex justify-center my-12">
            <div class="join">
                <% if (currentPage <= 1) { %>
                    <button class="join-item btn btn-sm btn-disabled" aria-label="Previous page">«</button>
                <% } else { %>
                    <a href="?page=<%= currentPage - 1 %><%= fullParams %>" class="join-item btn btn-sm" aria-label="Previous page">«</a>
                <% } %>

                <% for (let i=1; i <=totalPages; i++) { %>
                    <a href="?page=<%= i %><%= fullParams %>" class="join-item btn btn-sm <%= currentPage === i ? 'btn-active' : '' %>" aria-label="Page <%= i %>">
                        <%= i %>
                    </a>
                <% } %>

                <% if (currentPage >= totalPages) { %>
                    <button class="join-item btn btn-sm btn-disabled" aria-label="Next page">»</button>
                <% } else { %>
                    <a href="?page=<%= currentPage + 1 %><%= fullParams %>" class="join-item btn btn-sm" aria-label="Next page">»</a>
                <% } %>
            </div>
        </div>
        <% } %>
</div>