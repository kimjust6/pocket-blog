                                                                                class="absolute bottom-3 left-3 flex items-center gap-1.5 py-1 px-2.5 bg-base-100/60 backdrop-blur-md border border-white/20 shadow-md text-base-content text-xs font-medium rounded-full z-10">
                                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                                    class="h-3.5 w-3.5"
                                                                                    viewBox="0 0 20 20"
                                                                                    fill="currentColor">
                                                                                    <path fill-rule="evenodd"
                                                                                        d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                                                                                        clip-rule="evenodd" />
                                                                                </svg>
                                                                                <%= blog.location %>
                                                                            </div>
                                                                            <% } %>
                                                                </figure>
                                                                <% } %>
                                                                    <div class="card-body blog-body-transition p-6">
