<script server>
    const { buildBlogPostsPayload } = require(`${__hooks}/pages/utils/common.js`)

    if (typeof isHomepage === 'undefined') {
        var isHomepage = false
    }
    if (typeof isClimbing === 'undefined') {
        var isClimbing = false
    }
    const reqObj = typeof request !== 'undefined' ? request : null
    const postsPayload = buildBlogPostsPayload(isHomepage, isClimbing, params, reqObj, data)
    const {
        currentPage,
        totalPages,
        hasSearchQuery,
        heroPost,
        gridPosts,
        hasNoSearchResults,
        fullParams
    } = postsPayload

    if (typeof data !== 'undefined' && data) {
        data.initialRouteData = postsPayload
    }
</script>

<div class="bg-base-100 pt-16 flex flex-col justify-between <%= !isHomepage ? 'min-h-[calc(100vh-12.54rem)]' : 'pb-12' %>">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center">
            <% if (!isHomepage) { %>
                <% const sectionPath = isClimbing ? '/climbing' : '/blog/posts'; %>
                <a href="<%= sectionPath %>" class="no-underline">
                    <div class="mt-12 mb-6 text-center">
                        <h1 class="text-5xl font-bold text-accent">
                            <%= isClimbing ? 'The Climbing Blog' : 'The Dev Blog' %>
                        </h1>
                    </div>
                </a>
                <p class="mt-8 text-lg text-base-content">
                    <%= isClimbing ? 'A personal record of my falls, projects, and sends (on rock and in the gym).'
                        : 'Explore recent insights, retrospectives, and stories.' %>
                </p>
                <form role="search" action="<%= sectionPath %>" method="get" class="my-6 flex justify-center w-full">
                    <div class="relative w-full max-w-xl">
                        <label for="site-search-input" class="sr-only">
                            <%= isClimbing ? 'Search climbing logs' : 'Search blog posts' %>
                        </label>
                        <input type="text" inputmode="search" role="searchbox" name="query" id="site-search-input"
                            autocomplete="search" value="<%= postsPayload.rawQuery %>"
                            class="input input-bordered w-full rounded-full bg-base-100 border border-base-content/30 pl-5 pr-24 text-base focus:outline-none focus:ring-2 focus:ring-primary shadow-sm [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden [&::-webkit-search-results-button]:hidden [&::-webkit-search-results-decoration]:hidden"
                            placeholder="<%= isClimbing ? 'Search climbs or locations...' : 'Search blogs...' %>"
                            aria-label="<%= isClimbing ? 'Search climbing logs' : 'Search blog posts' %>" />
                        <div class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-1" style="right: 0.75rem;">
                            <% if (postsPayload.rawQuery) { %>
                                <a href="<%= sectionPath %>"
                                    class="btn btn-ghost btn-xs btn-circle opacity-70 hover:opacity-100 text-base-content"
                                    aria-label="Clear search">
                                    <%- include('icon.ejs', { name: 'close' }) %>
                                </a>
                            <% } %>
                            <button type="submit" class="btn btn-primary btn-sm btn-circle shrink-0" aria-label="Submit search">
                                <%- include('icon.ejs', { name: 'search' }) %>
                            </button>
                        </div>
                    </div>
                </form>
                <% if (!hasSearchQuery) { %>
                    <div class="my-8 w-full">
                        <div class="flex justify-end w-full">
                            <a href="/" class="btn btn-accent btn-sm gap-2 transition-all duration-200 rounded-xl">
                                <%- include('icon.ejs', { name: 'back' }) %>
                                Back Home
                            </a>
                        </div>
                    </div>
                <% } %>
            <% } %>
        </div>

        <% if (heroPost) { %>
            <!-- Hero Post -->
            <div class="mb-24">
                <a href="<%= heroPost.link %>" class="no-underline group"
                    onclick="if(window.gtag) window.gtag('event', 'click', { event_category: '<%= heroPost.itemIsClimbing ? `climbing_log` : `blog_post` %>', event_label: decodeURIComponent('<%= encodeURIComponent(heroPost.title) %>') })">
                    <div class="card w-full lg:card-side glass-card shadow-2xl lg:shadow-xl blog-card-transition overflow-hidden rounded-xl relative"
                        style="--blog-card-id: blog-card-<%= heroPost.id %>">
                        <span
                            class="absolute py-1 px-2 sm:py-2 sm:px-4 bg-accent/90 backdrop-blur-md border border-accent-content/20 shadow-lg text-accent-content text-xs md:text-sm lg:text-base font-semibold uppercase tracking-wide z-10 rounded-full"
                            style="position-anchor: --blog-image; bottom:calc(anchor(bottom) + 0.75rem); left:calc(anchor(left) + 0.75rem); view-transition-name: latest-post-badge">Latest
                            Post</span>
                        <% if (heroPost.heroImageUrl) { %>
                            <figure class="lg:w-1/2 h-auto m-0 rounded-t-lg lg:rounded-t-none lg:rounded-l-lg">
                                <img src="<%= heroPost.heroImageUrl %>" alt="<%= heroPost.title %>"
                                    class="w-full h-full object-cover blog-image-transition rounded-t-lg lg:rounded-t-none lg:rounded-l-lg"
                                    style="--blog-image-id: blog-image-<%= heroPost.id %>; anchor-name: --blog-image"
                                    width="610" height="407" fetchpriority="high" decoding="async" />
                            </figure>
                        <% } %>
                        <div class="card-body lg:w-1/2 justify-center blog-body-transition p-8 md:p-12">
                            <h2 class="card-title text-3xl md:text-4xl font-bold text-secondary mt-0 blog-title-transition"
                                style="--blog-title-id: blog-title-<%= heroPost.id %>">
                                <%= heroPost.title %>
                            </h2>
                            <%- include('badges.ejs', {
                                badges: heroPost.badges,
                                isClimbing: heroPost.itemIsClimbing,
                                sizeClass: 'lg:badge-lg',
                                wrapClass: 'flex flex-wrap pb-4 gap-2',
                                stopPropagation: true
                            }) %>
                            <p class="text-lg text-base-content mt-4 line-clamp-4">
                                <%= heroPost.previewText %>
                            </p>
                            <span class="text-sm text-base-content/60 block">
                                <%= heroPost.formattedDate %>
                            </span>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>

        <% if (hasNoSearchResults) { %>
            <div class="mx-auto max-w-xl py-16 text-center">
                <h1 class="mb-4 text-5xl font-bold text-accent">No search results</h1>
                <p class="mb-6 text-lg text-base-content">
                    <%= isClimbing ? 'No climbing entries' : 'No blog posts' %> matched "<%= params.query %>".
                </p>
                <a href="<%= isClimbing ? '/climbing' : '/blog/posts' %>" class="btn btn-primary">Clear Search</a>
            </div>
        <% } else { %>
            <% if (hasSearchQuery) { %>
                <div class="mb-12 pt-8 text-center">
                    <p class="mb-4 text-lg text-base-content">Results for
                        <span class="text-lg text-secondary font-semibold">"<%= params.query %>"</span>
                    </p>
                </div>
            <% } else if (heroPost) { %>
                <a href="<%= isClimbing ? '/climbing' : '/blog/posts' %>" class="no-underline">
                    <div class="mb-12 text-center">
                        <h2 class="text-5xl font-bold text-accent">Older Posts</h2>
                    </div>
                </a>
            <% } %>

            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                <% gridPosts.forEach((blog, index) => { %>
                    <a href="<%= blog.link %>" class="no-underline group"
                        onclick="if(window.gtag) window.gtag('event', 'click', { event_category: '<%= blog.itemIsClimbing ? `climbing_log` : `blog_post` %>', event_label: decodeURIComponent('<%= encodeURIComponent(blog.title) %>') })">
                        <div class="card glass-card shadow-xl blog-card-transition overflow-hidden rounded-xl"
                            style="--blog-card-id: blog-card-<%= blog.id %>">
                            <% if (blog.gridImageUrl) { %>
                                <figure class="h-auto md:h-48 overflow-hidden m-0 rounded-t-lg relative">
                                    <% const isLcp = (!isHomepage && index === 0); %>
                                    <img src="<%= blog.gridImageUrl %>"
                                        alt="<%= blog.title %>"
                                        class="w-full h-auto md:h-48 object-cover blog-image-transition rounded-t-lg"
                                        style="--blog-image-id: blog-image-<%= blog.id %>"
                                        width="350" height="192" decoding="async"
                                        <%= isLcp ? 'fetchpriority="high"' : 'loading="lazy"' %> />
                                    <% if (blog.location) { %>
                                        <% const gridLocationUrl = (blog.itemIsClimbing ? '/climbing' : '/blog/posts') + '?query=' + encodeURIComponent(blog.location); %>
                                        <div onclick="event.preventDefault(); event.stopPropagation(); window.location.href='<%= gridLocationUrl %>';"
                                            class="location-pill">
                                            <%- include('icon.ejs', { name: 'location' }) %>
                                            <%= blog.location %>
                                        </div>
                                    <% } %>
                                </figure>
                            <% } %>
                            <div class="card-body blog-body-transition p-6">
                                <h2 class="card-title text-xl font-bold text-secondary my-0 blog-title-transition"
                                    style="--blog-title-id: blog-title-<%= blog.id %>">
                                    <%= blog.title %>
                                </h2>
                                <%- include('badges.ejs', {
                                    badges: blog.badges,
                                    isClimbing: blog.itemIsClimbing,
                                    sizeClass: 'badge-sm h-auto',
                                    wrapClass: 'flex flex-wrap gap-2',
                                    stopPropagation: true
                                }) %>
                                <p class="text-sm text-base-content line-clamp-3">
                                    <%= blog.previewText %>
                                </p>
                                <span class="text-xs text-base-content/60 mt-2">
                                    <%= blog.formattedDate %>
                                </span>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>
    </div>

    <% if (!isHomepage && !hasNoSearchResults) { %>
        <!-- Pagination -->
        <nav aria-label="Pagination" class="flex justify-center my-12">
            <div class="join">
                <% if (currentPage <= 1) { %>
                    <button class="join-item btn btn-sm btn-disabled" aria-label="Previous page" disabled aria-disabled="true">«</button>
                <% } else { %>
                    <a href="?page=<%= currentPage - 1 %><%= fullParams %>" class="join-item btn btn-sm" aria-label="Previous page">«</a>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                    <a href="?page=<%= i %><%= fullParams %>"
                        class="join-item btn btn-sm <%= currentPage === i ? 'btn-active' : '' %>"
                        <% if (currentPage === i) { %>aria-current="page"<% } %>
                        aria-label="Page <%= i %>">
                        <%= i %>
                    </a>
                <% } %>

                <% if (currentPage >= totalPages) { %>
                    <button class="join-item btn btn-sm btn-disabled" aria-label="Next page" disabled aria-disabled="true">»</button>
                <% } else { %>
                    <a href="?page=<%= currentPage + 1 %><%= fullParams %>" class="join-item btn btn-sm" aria-label="Next page">»</a>
                <% } %>
            </div>
        </nav>
    <% } %>
</div>
