<script server>
    const { formatDateTime, getImageUrl } = resolve('../../utils/common')
    const { POCKET_BLOGPOSTS } = resolve('../../utils/constants')

    if (typeof isHomepage === 'undefined') {
        var isHomepage = false
    }
    function fetchBlogPosts(page, perPage, query) {
        const client = pb({ request })
        let filter = 'isDeleted = false'
        if (query) {
            filter = `${filter} && (title ~ "${query}" || tags ~ "${query}" || content1 ~ "${query}" || content2 ~ "${query}")`
        }

        return client.collection(POCKET_BLOGPOSTS).getList(page, perPage, {
            sort: '-created',
            filter,
        })
    }
    const currentPage = params?.page ?? 1
    const perPage = params?.perPage ?? 6
    
    blogposts = fetchBlogPosts(currentPage, perPage, params.query) ?? []
    const totalPages = blogposts?.totalPages || 1
</script>

<script>
    const SearchApp = {
        searchQuery: '<%= params?.query || "" %>',
        hasQuery: '<%= params?.query ? "true" : "" %>',
        handleSearch() {
            // Update query params in URL
            window.location.href = `?query=${encodeURIComponent(this.searchQuery)}`
        },
        clearSearch() {
            this.searchQuery = ''
            this.$refs.searchInput.focus()
            if (this.hasQuery) {
                window.location.href = '/blog/posts'
            }
        },
        mounted() {
            this.$refs.searchInput.focus()
        },
    }
</script>

<div
    class="mt-16 flex flex-col gap-12 <%= !isHomepage ? 'min-h-[calc(100vh-14rem)]' : '' %>"
    v-scope="SearchApp"
>
    <section class="glass-panel border border-white/10 px-6 py-10 text-center">
        <div class="space-y-4">
            <a href="/blog/posts" class="no-underline">
                <!-- <p class="text-xs uppercase tracking-[0.5em] text-base-content/70">
                    Digital garden
                </p> -->
                <h1 class="text-4xl font-semibold">Latest posts</h1>
            </a>
            <p class="text-base text-base-content/70 max-w-3xl mx-auto">
                Explore recent insights, retrospectives, and stories...
            </p>
        </div>
        <% if (!isHomepage) { %>
        <div class="mt-8 flex flex-col gap-6">
            <div class="relative mx-auto w-full max-w-2xl">
                <input
                    autofocus
                    v-model="searchQuery"
                    ref="searchInput"
                    class="input input-lg w-full border border-white/20 bg-base-100/60 pr-14"
                    placeholder="Search by title, tags, or keywords..."
                    @keydown.enter="handleSearch"
                />
                <button
                    v-show="searchQuery"
                    @click="clearSearch"
                    class="btn btn-ghost btn-sm btn-circle absolute right-3 top-1/2 -translate-y-1/2 border border-white/20"
                    type="button"
                >
                    ✕
                </button>
            </div>

            <div class="flex justify-between flex-wrap gap-3 text-sm text-base-content/70">
                <a
                    href="/"
                    class="btn btn-outline btn-sm gap-2 transition-all duration-200"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="m12 19-7-7 7-7" />
                        <path d="M19 12H5" />
                    </svg>
                    Back Home
                </a>

            </div>
        </div>
        <% } %>
    </section>

    <% if (!blogposts?.items?.length) { %>
    <div class="glass-panel border border-error/20 p-8 text-center">
        <p class="text-lg font-semibold">No posts just yet.</p>
        <p class="text-base-content/70">
            Try clearing the filters or swing back soon for fresh notes.
        </p>
    </div>
    <% } else { %>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <% blogposts?.items?.forEach(blog => { 
            const text = blog.content1.replace(/<[^>]*>/g, ''); 
            const myImageUrl = getImageUrl(blog) ? `${getImageUrl(blog)}?thumb=350x0` 
            : blog.coverImageAlt 
            const hasImage = myImageUrl !== null && myImageUrl !== '' %>

        <a
            href="/blog/posts/<%= blog.id %>"
            class="no-underline group h-full"
        >
            <article
                class="blog-card-modern blog-card-transition flex h-full flex-col gap-5 overflow-hidden border border-white/10 p-4"
                style="--blog-card-id: blog-card-<%= blog.id %>"
            >
                <div class="relative h-52 w-full overflow-hidden rounded-3xl">
                    <% if (hasImage) { %>
                    <img
                        src="<%= myImageUrl%>"
                        alt="<%= blog.title %> Image"
                        class="h-full w-full object-cover blog-image-transition transition duration-500 group-hover:scale-105"
                        style="--blog-image-id: blog-image-<%= blog.id %>"
                        loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-base-100/90 via-base-100/20 to-transparent"></div>
                    <% } else { %>
                    <div
                        class="flex h-full w-full items-center justify-center rounded-3xl bg-gradient-to-br from-primary/30 to-secondary/30 text-base-content/70"
                    >
                        Field notes
                    </div>
                    <% } %>
                    <div
                        class="absolute bottom-4 left-4 text-xs uppercase tracking-[0.4em] text-base-content"
                    >
                        <%= formatDateTime(new Date(blog.updated)) %>
                    </div>
                </div>
                <div class="flex flex-1 flex-col gap-4 px-2 pb-4">
                    <div class="flex flex-wrap gap-2 text-[0.65rem] uppercase text-base-content/60">
                        <% if (blog.tags && blog.tags?.length > 0) {
                            blog.tags?.split(';').forEach(tag => { %>
                        <span class="feature-pill"><%= tag %></span>
                        <% }) %>
                        <% } else { %>
                        <span class="feature-pill">Writing</span>
                        <% } %>
                    </div>
                    <h2
                        class="text-2xl font-semibold leading-snug text-base-content blog-title-transition transition-colors duration-300 group-hover:text-primary"
                        style="--blog-title-id: blog-title-<%= blog.id %>"
                    >
                        <%= blog.title %>
                    </h2>
                    <p class="flex-1 text-base-content/80">
                        <%= text.slice(0, 110) %>...
                    </p>
                    <div
                        class="flex items-center justify-between text-sm font-semibold text-primary"
                    >
                        <span>Read story</span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="transition duration-300 group-hover:translate-x-1.5"
                        >
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </div>
                </div>
            </article>
        </a>
        <% }) %>
    </div>
    <% } %>

    <% if (!isHomepage) { %>
    <div class="flex justify-center pb-8">
        <div class="join shadow-lg shadow-base-300/30">
            <a href="?page=<%= currentPage - 1 %>" 
            class="join-item btn btn-sm"
            <% if (currentPage <= 1) { %> disabled <% } %>>
            «
            </a>

            <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="?page=<%= i %>" 
                class="join-item btn btn-sm <%= currentPage === i ? 'btn-active' : '' %>">
                <%= i %>
            </a>
            <% } %>

            <a href="?page=<%= currentPage + 1 %>" 
            class="join-item btn btn-sm"
            <% if (currentPage >= totalPages) { %> disabled <% } %>>
            »
            </a>
        </div>
    </div>
    <% } %>
</div>
