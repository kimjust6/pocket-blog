                                                                    class="loading loading-spinner loading-lg text-accent"
                                                                    role="status"
                                                                    aria-label="Loading more posts"></span>
                                                            </div>
                                                            <% } %>
                                            </div>
                                            <% } %>
    </div>
    <% if (!isHomepage && !hasNoSearchResults) { %>
        <!-- Pagination -->
        <nav aria-label="Pagination" class="flex justify-center my-12">
            <div class="join">
                <% if (currentPage <=1) { %>
                    <button class="join-item btn btn-sm btn-disabled" aria-label="Previous page" disabled
                        aria-disabled="true">«</button>
                    <% } else { %>
                        <a href="?page=<%= currentPage - 1 %><%= fullParams %>" class="join-item btn btn-sm"
