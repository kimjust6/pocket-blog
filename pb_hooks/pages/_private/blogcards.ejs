                                                        <!-- Dynamically Loaded Posts (Infinite Scroll) -->
                                                        <a v-for="blog in extraPosts" :key="blog.id" :href="blog.link"
                                                            class="no-underline group">
                                                            <div class="card dark:bg-base-300/70 bg-base-300/60 hover:bg-base-300/80 dark:hover:bg-base-300/90 backdrop-blur-xl shadow-xl transition-all duration-300 blog-card-transition overflow-hidden rounded-xl border border-base-content/10"
                                                                :style="'--blog-card-id: blog-card-' + blog.id">
                                                                <figure v-if="blog.imageUrl"
                                                                    class="h-auto md:h-48 overflow-hidden m-0 rounded-t-lg relative">
