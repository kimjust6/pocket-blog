<!-- Footer -->
<footer class="glass-surface border-t border-base-content/10">
    <!-- Bottom Bar -->
    <div
        class="py-10 border-base-300 text-center text-sm text-base-content flex flex-col items-center justify-center px-14 gap-4">
        <!-- Social Media -->
        <nav aria-label="Social media links">
            <ul class="text-base-content text-sm flex gap-6 flex-row flex-wrap justify-center items-center">
                <% (data.socials || []).forEach(social => { %>
                    <li>
                        <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer"
                            class="font-medium text-base-content hover:text-secondary transition-colors duration-200 no-underline">
                            <%= social.name %>
                            <span class="sr-only">(opens in a new tab)</span>
                        </a>
                    </li>
                <% }) %>
            </ul>
        </nav>
        <p class="opacity-60">&copy; <%= new Date().getFullYear() %> Justin K. All rights reserved.</p>
    </div>
</footer>
