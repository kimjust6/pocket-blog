<nav class="navbar glass-surface w-full fixed top-0 left-0 right-0 z-40 navbar-persistent"
    aria-label="Main Navigation">
    <div class="flex-none lg:hidden">
        <!-- hamburger icon -->
        <label for="my-drawer-3" aria-label="Open sidebar menu" class="btn btn-square btn-ghost">
            <%- include('icon.ejs', { name: 'menu' }) %>
        </label>
    </div>

    <div class="menu menu-horizontal mx-2 flex-1 px-2">
        <a href="/"
            class="font-medium hover:text-secondary transition-colors duration-200 no-underline text-base-content"
            aria-current="<%= data.currentPath === '/' ? 'page' : 'false' %>">Home</a>
    </div>
    <div class="hidden flex-none lg:flex items-center gap-6 px-2 text-sm">
        <% (data.navigation || []).forEach(function(item) { %>
            <a href="<%= item.url %>"
                class="font-medium hover:text-secondary transition-colors duration-200 no-underline <%= data.currentPath === item.url ? 'text-accent' : 'text-base-content' %>">
                <%= item.title %>
            </a>
        <% }); %>
    </div>
    <div class="flex-none ml-2">
        <button onclick="toggleTheme()" type="button"
            class="flex items-center justify-center group cursor-pointer bg-transparent p-2 rounded-xl border border-transparent hover:border-accent/50 transition-all duration-200"
            aria-label="Toggle theme">
            <%- include('icon.ejs', {
                name: 'sun',
                svgId: 'theme-icon-sun',
                iconClass: `h-5 w-5 fill-transparent stroke-accent group-hover:fill-accent group-hover:scale-110 transition-all duration-200 ${data.theme === 'dark' ? '' : 'hidden'}`
            }) %>
            <%- include('icon.ejs', {
                name: 'moon',
                svgId: 'theme-icon-moon',
                iconClass: `h-5 w-5 fill-transparent stroke-accent group-hover:fill-accent group-hover:scale-110 transition-all duration-200 ${data.theme === 'nord' ? '' : 'hidden'}`
            }) %>
        </button>
    </div>
</nav>
