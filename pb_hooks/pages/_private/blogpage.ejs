<script server>
    const { prepareBlogSingleViewData } = require(`${__hooks}/pages/utils/common.js`)

    if (typeof isClimbing === 'undefined') {
        var isClimbing = false
    }

    if (typeof singleBlog === 'undefined') {
        var singleBlog = null
    }

    if (typeof blogView === 'undefined' || blogView === null) {
        const reqObj = typeof request !== 'undefined' ? request : null
        var blogView = prepareBlogSingleViewData(singleBlog, isClimbing, params, data, reqObj)
    }
</script>
<% if (blogView == null) { %>
    <%- include('pagenotfound.ejs') %>
<% } else { %>
    <article class="hero bg-base-200 py-12 min-h-[calc(100vh-12.54rem)] flex flex-col items-center justify-start blog-card-transition"
        style="--blog-card-id: blog-card-<%= blogView.id %>">
        <div class="hero-content max-w-4xl flex flex-col w-full gap-0">
            <!-- Blog Image -->
            <% if (blogView.imageUrl) { %>
                <img src="<%= blogView.imageUrl %>"
                    class="rounded-xl shadow-lg w-full h-auto max-h-96 object-cover m-0 mb-6 blog-image-transition"
                    style="--blog-image-id: blog-image-<%= blogView.id %>; aspect-ratio: 16/9;"
                    alt="<%= blogView.coverImageAlt || blogView.title %>" width="896" height="504" fetchpriority="high" decoding="async" />
            <% } %>
            <!-- Blog Title, Tags & Meta Header -->
            <div class="w-full pt-6 pb-8 border-b border-base-content/10 flex flex-col gap-4">
                <h1 class="text-4xl md:text-5xl font-bold text-accent leading-tight blog-title-transition text-center mb-2"
                    style="--blog-title-id: blog-title-<%= blogView.id %>">
                    <%= blogView.title %>
                </h1>

                <!-- Tags -->
                <%- include('badges.ejs', {
                    badges: blogView.badges,
                    isClimbing: blogView.isClimbing,
                    sizeClass: 'badge-lg',
                    wrapClass: 'flex flex-wrap gap-2',
                    stopPropagation: false
                }) %>

                <!-- Back to Posts & Dates Meta Bar -->
                <div class="flex justify-between items-center w-full text-sm text-base-content flex-wrap gap-4">
                    <div class="flex items-center gap-2 flex-wrap">
                        <button type="button"
                            onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '<%= blogView.backLink %>'; }"
                            class="btn btn-accent btn-sm gap-2 rounded-full transition-all duration-200">
                            <%- include('icon.ejs', { name: 'back' }) %>
                            Back
                        </button>
                        <a href="<%= blogView.backLink %>"
                            class="btn btn-accent btn-sm gap-2 rounded-full transition-all duration-200">
                            <%- include('icon.ejs', { name: blogView.isClimbing ? 'mountain' : 'code' }) %>
                            <%= blogView.backLabel %>
                        </a>
                    </div>
                    <div class="text-right flex flex-col items-end gap-1">
                        <div>
                            <%= blogView.dateLabel %>:
                            <% if (blogView.dateIso) { %>
                                <time datetime="<%= blogView.dateIso %>"><strong><%= blogView.formattedDate %></strong></time>
                            <% } else { %>
                                <strong><%= blogView.formattedDate %></strong>
                            <% } %>
                            <% if (blogView.readingTime) { %>
                                <span class="mx-1 text-base-content/40">•</span>
                                <span class="inline-flex items-center gap-1 text-xs opacity-75">
                                    <%- include('icon.ejs', { name: 'clock' }) %>
                                    <%= blogView.readingTime %>
                                </span>
                            <% } %>
                        </div>
                        <% if (blogView.formattedUpdated) { %>
                            <div class="text-xs text-base-content/70">
                                Updated:
                                <% if (blogView.updatedIso) { %>
                                    <time datetime="<%= blogView.updatedIso %>"><strong><%= blogView.formattedUpdated %></strong></time>
                                <% } else { %>
                                    <strong><%= blogView.formattedUpdated %></strong>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Blog Content Body -->
            <div class="w-full self-start backdrop-blur-md px-4 sm:px-8 pt-6 pb-8 rounded-xl">
                <div class="prose max-w-none text-base-content min-w-0 w-full font-normal leading-relaxed">
                    <%- blogView.cleanContent %>
                </div>
                <% if (blogView.cleanContent2) { %>
                    <div class="prose max-w-none text-base-content mt-6 min-w-0 w-full font-normal leading-relaxed">
                        <%- blogView.cleanContent2 %>
                    </div>
                <% } %>
            </div>

            <!-- Previous & Next Post Navigation -->
            <% if (blogView.prevPost || blogView.nextPost) { %>
                <nav aria-label="Adjacent Posts" class="w-full mt-10 pt-8 border-t border-base-content/10 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <% if (blogView.prevPost) { %>
                        <a href="<%= blogView.prevPost.link %>" class="card bg-base-100 hover:bg-base-200 border border-base-content/10 p-5 rounded-xl no-underline transition-all duration-200 group flex flex-col justify-between">
                            <span class="text-xs font-semibold uppercase tracking-wider text-accent flex items-center gap-1.5 mb-2">
                                <%- include('icon.ejs', { name: 'back' }) %>
                                Older <%= blogView.isClimbing ? 'Log' : 'Post' %>
                            </span>
                            <span class="text-base font-bold text-base-content group-hover:text-primary transition-colors duration-200 line-clamp-2">
                                <%= blogView.prevPost.title %>
                            </span>
                            <span class="text-xs text-base-content/60 mt-3"><%= blogView.prevPost.formattedDate %></span>
                        </a>
                    <% } else { %>
                        <div class="hidden sm:block"></div>
                    <% } %>

                    <% if (blogView.nextPost) { %>
                        <a href="<%= blogView.nextPost.link %>" class="card bg-base-100 hover:bg-base-200 border border-base-content/10 p-5 rounded-xl no-underline transition-all duration-200 group flex flex-col justify-between sm:text-right">
                            <span class="text-xs font-semibold uppercase tracking-wider text-accent flex items-center gap-1.5 sm:justify-end mb-2">
                                Newer <%= blogView.isClimbing ? 'Log' : 'Post' %>
                                <%- include('icon.ejs', { name: 'next' }) %>
                            </span>
                            <span class="text-base font-bold text-base-content group-hover:text-primary transition-colors duration-200 line-clamp-2">
                                <%= blogView.nextPost.title %>
                            </span>
                            <span class="text-xs text-base-content/60 mt-3"><%= blogView.nextPost.formattedDate %></span>
                        </a>
                    <% } %>
                </nav>
            <% } %>
        </div>
    </article>
<% } %>
