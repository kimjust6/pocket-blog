<script server>
    const { formatDateTime, getImageUrl, slugifyTitle } =
        resolve('../../utils/common')
    const { getBlogPostsByTitlePrefix } = resolve('../../utils/pocket')

    if (typeof isClimbing === 'undefined') {
        var isClimbing = false
    }

    if (typeof singleBlog === 'undefined') {
        var singleBlog = null
    }

    let imageUrl = null

    // singleBlog might be passed in already, if not let's fetch it:
    if (!singleBlog && params?.title) {
        try {
            const firstWord = params.title.split('-')[0].replace(/"/g, '\\"')
            const possibleBlogs = getBlogPostsByTitlePrefix(firstWord)

            const targetSlug = params.title.toLowerCase()
            singleBlog =
                possibleBlogs.find(
                    (b) => slugifyTitle(b.getString('title')) === targetSlug
                ) || null
        } catch (error) {
            console.error('Error fetching single blog post: ', error)
        }
    }

    if (singleBlog) {
        try {
            if (!singleBlog) {
                return res.status(404).render('pagenotfound')
            }
            // Update the page title metadata
            const newTitle = isClimbing
                ? `${singleBlog.getString('title')} | Climbing Blog`
                : `${singleBlog.getString('title')} | The Justin Blog`
            data.metadata
                .filter((m) => m.name.includes('title'))
                .forEach((m) => (m.content = newTitle))
            // replace the metadata image as well
            data.metadata
                .filter(
                    (m) => m.name === 'og:image' || m.name === 'twitter:image'
                )
                .forEach((m) => (m.content = getImageUrl(singleBlog)))
            // update the description metadata
            const description = singleBlog
                .getString(isClimbing ? 'content' : 'content1')
                .replace(/<[^>]*>/g, '')
                .slice(0, 160)
                .trim()
            data.metadata
                .filter(
                    (m) =>
                        m.name === 'description' ||
                        m.name === 'og:description' ||
                        m.name === 'twitter:description'
                )
                .forEach((m) => (m.content = description))

            // add tags to metadata
            if (isClimbing) {
                const climbType = singleBlog.getString('climbType')
                const grade = singleBlog.getString('grade')
                const style = singleBlog.getString('style')
                const location = singleBlog.getString('location')
                const climbTags = [climbType, grade, style, location].filter(
                    Boolean
                )
                climbTags.forEach((tag) => {
                    data.metadata.push({
                        name: 'article:tag',
                        content: tag,
                    })
                })
                data.metadata.push({
                    name: 'keywords',
                    content: climbTags.join(', '),
                })
            } else {
                const blogTags = singleBlog.getString('tags')
                if (blogTags && blogTags.length > 0) {
                    const tags = blogTags.split(';')
                    tags.forEach((tag) => {
                        data.metadata.push({
                            name: 'article:tag',
                            content: tag.trim(),
                        })
                    })
                    data.metadata.push({
                        name: 'keywords',
                        content: tags.join(', '),
                    })
                }
            }

            // add published and modified times
            const publishedDate = isClimbing
                ? singleBlog.getString('date')
                : singleBlog.getString('manualPublishDate') ||
                  singleBlog.getString('created')
            console.log({ publishedDate })
            if (publishedDate) {
                data.metadata.push({
                    name: 'article:published_time',
                    content: new Date(publishedDate).toISOString(),
                })
            }
            const updatedDate = singleBlog.getString('updated')
            if (updatedDate) {
                data.metadata.push({
                    name: 'article:modified_time',
                    content: new Date(updatedDate).toISOString(),
                })
            }

            // set og:type to article
            const ogType = data.metadata.find((m) => m.name === 'og:type')
            if (ogType) {
                ogType.content = 'article'
            } else {
                data.metadata.push({
                    name: 'og:type',
                    content: 'article',
                })
            }
        } catch (error) {
            console.error('Error setting metadata: ', error)
        }
        //get length of imageUrl
        const coverImageAlt = singleBlog?.getString('coverImageAlt')
        imageUrl = isClimbing
            ? (getImageUrl(singleBlog) ? `${getImageUrl(singleBlog)}?thumb=1000x0` : '/background.webp')
            : getImageUrl(singleBlog)
              ? `${getImageUrl(singleBlog)}?thumb=1000x0`
              : (coverImageAlt || null)
    }
</script>
<% if (singleBlog==null) { %>
<%- include('pagenotfound.ejs') %>
<% } else { %>
<div
    class="hero bg-base-100 py-12 min-h-[calc(100vh-12.54rem)] flex flex-col items-center justify-start blog-card-transition"
    style="--blog-card-id: blog-card-<%= singleBlog?.id %>"
>
    <div class="hero-content max-w-4xl flex flex-col">
        <div class="w-full backdrop-blur-md p-6 rounded-xl mb-8">
            <h1
                class="md:mb-0 font-extrabold text-3xl leading-tight md:flex hidden blog-title-transition"
                style="--blog-title-id: blog-title-<%= singleBlog?.id %>"
            >
                <%= singleBlog?.getString('title') %>
            </h1>
        </div>
        <!-- Blog Image -->
        <% if (imageUrl) { %>
        <img
            src="<%= imageUrl %>"
            class="rounded-xl shadow-lg w-full h-auto max-h-96 object-cover m-0 blog-image-transition"
            style="
                --blog-image-id: blog-image-<%= singleBlog?.id %>;
                aspect-ratio: 16/9;
            "
            alt="<%= singleBlog?.getString('title') %> image"
            width="896"
            height="504"
            fetchpriority="high"
        />
        <% } %>
        <!-- Blog Content -->
        <div class="w-full self-start backdrop-blur-md p-8 rounded-xl">
            <h1
                class="mb-0 font-extrabold sm:text-2xl leading-tight flex md:hidden blog-title-transition"
                style="--blog-title-id: blog-title-<%= singleBlog?.id %>"
            >
                <%= singleBlog?.getString('title') %>
            </h1>
            <!-- Tags -->
            <div class="flex flex-wrap gap-2">
                <% if (isClimbing) { %>
                <span class="badge badge-outline badge-lg text-nowrap">
                    <%= singleBlog?.getString('climbType') %>
                </span>
                <% if (singleBlog?.getString('grade')) { %>
                <span class="badge badge-outline badge-lg text-nowrap">
                    <%= singleBlog?.getString('grade') %>
                </span>
                <% } %>
                <% if (singleBlog?.getString('style')) { %>
                <span class="badge badge-outline badge-lg text-nowrap">
                    <%= singleBlog?.getString('style') %>
                </span>
                <% } %>
                <% if (singleBlog?.getString('location')) { %>
                <span class="badge badge-outline badge-lg text-nowrap">
                    <%= singleBlog?.getString('location') %>
                </span>
                <% } %>
                <% } else { %>
                <% const pageTags=singleBlog?.getString('tags'); if (pageTags &&
                pageTags.length> 0) { pageTags.split(';').forEach(function(tag)
                { %>
                <% if (tag.trim()) { %>
                <a
                    href="/blog/posts?query=<%= encodeURIComponent(tag.trim()) %>"
                    class="no-underline"
                >
                    <span
                        class="badge badge-outline badge-lg text-nowrap hover:bg-base-content hover:text-base-100 transition-all duration-200 cursor-pointer"
                    >
                        <%= tag.trim() %>
                    </span>
                </a>
                <% } %>
                <% }); %>
                <% } %>
                <% } %>
            </div>

            <div class="text-sm text-base-content">
                <!-- Back to Posts Button -->
                <div class="mt-6">
                    <div class="flex justify-between items-center w-full">
                        <a
                            href="<%= isClimbing ? '/climbing' : '/blog/posts' %>"
                            class="btn btn-outline btn-sm gap-2 transition-all duration-200"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="m12 19-7-7 7-7" />
                                <path d="M19 12H5" />
                            </svg>
                            <%= isClimbing ? 'Back to journal' : 'View all posts' %>
                        </a>
                        <!-- <span>By: <strong>Justin K</strong></span> -->
                        <div class="text-right">
                            <%= isClimbing ? 'Logged' : 'Posted' %>:
                            <strong>
                                <%= formatDateTime(new
                                                                 Date(isClimbing ? singleBlog?.getString('date') : (singleBlog?.getString('manualPublishDate') ||
                                                                 singleBlog?.getString('created')))) %>
                            </strong>
                            <div class="text-right">
                                Updated:
                                <strong>
                                    <%= formatDateTime(new
                                                                     Date(singleBlog?.getString('updated'))) %>
                                </strong>
                            </div>
                        </div>
                    </div>

                    <% const toNoCookie = (s) => (s || '')
                        .replace(/https?:\/\/(www\.)?youtube\.com\/embed\//g, 'https://www.youtube-nocookie.com/embed/')
                        .replace(/<iframe([^>]*?)(?:\s+sandbox="[^"]*")?([^>]*?)>/gi, (match, pre, post) => {
                            const isYT = /youtube(-nocookie)?\.com\/embed\//.test(match);
                            if (!isYT) return match;
                            const stripped = match.replace(/\s+sandbox="[^"]*"/gi, '');
                            const hasAllow = /\ballow=/i.test(stripped);
                            return hasAllow
                                ? stripped
                                : stripped.replace(/<iframe/i, '<iframe allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen');
                        }) %>
                    <% if (isClimbing) { %>
                    <div
                        class="prose max-w-none text-base-content mt-6 min-w-80 font-normal leading-relaxed"
                    >
                        <%- toNoCookie(singleBlog?.getString('content')) %>
                    </div>
                    <% } else { %>
                    <p class="text-base-content min-w-80">
                        <%- toNoCookie(singleBlog?.getString('content1')) %>
                    </p>
                    <p class="text-base-content mb-6 min-w-80">
                        <%- toNoCookie(singleBlog?.getString('content2')) %>
                    </p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <script>
        if (typeof window.gtag === 'function') {
            window.gtag('event', 'view_item', {
                event_category:
                    '<%= isClimbing ? "climbing_engagement" : "blog_engagement" %>',
                item_id: '<%= singleBlog?.id %>',
                item_name: decodeURIComponent(
                    '<%= encodeURIComponent(singleBlog?.getString("title") || "") %>'
                ),
                item_category: decodeURIComponent(
                    '<%= encodeURIComponent(isClimbing ? (singleBlog?.getString("climbType") || "") : (singleBlog?.getString("tags") || "")) %>'
                ),
                author: 'Justin K',
            })
        }
    </script>
    <% } %>
</div>
