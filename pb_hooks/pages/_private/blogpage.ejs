<script server>
    const { formatDateTime, getImageUrl, slugifyTitle, prepareBlogSingleViewData } =
        resolve('../../utils/common')

    if (typeof isClimbing === 'undefined') {
        var isClimbing = false
    }

    if (typeof singleBlog === 'undefined') {
        var singleBlog = null
    }

    const reqObj = typeof request !== 'undefined' ? request : null
    singleBlog = prepareBlogSingleViewData(singleBlog, isClimbing, params, data, reqObj)

    let imageUrl = null
    if (singleBlog) {
        const coverImageAlt = singleBlog?.getString('coverImageAlt')
        imageUrl = isClimbing
            ? (getImageUrl(singleBlog) ? `${getImageUrl(singleBlog)}?thumb=1000x0` : '/background.webp')
            : getImageUrl(singleBlog)
              ? `${getImageUrl(singleBlog)}?thumb=1000x0`
              : (coverImageAlt || null)
    }
</script>
<% if (singleBlog==null) { %>
<%- include('pagenotfound.ejs') %>
<% } else { %>
<div
    class="hero bg-base-100 py-12 min-h-[calc(100vh-12.54rem)] flex flex-col items-center justify-start blog-card-transition"
    style="--blog-card-id: blog-card-<%= singleBlog?.id %>"
>
    <div class="hero-content max-w-4xl flex flex-col">
        <div class="w-full backdrop-blur-md p-6 rounded-xl mb-8">
            <h1
                class="md:mb-0 font-extrabold text-3xl leading-tight md:flex hidden blog-title-transition"
                style="--blog-title-id: blog-title-<%= singleBlog?.id %>"
            >
                <%= singleBlog?.getString('title') %>
            </h1>
        </div>
        <!-- Blog Image -->
        <% if (imageUrl) { %>
        <img
            src="<%= imageUrl %>"
            class="rounded-xl shadow-lg w-full h-auto max-h-96 object-cover m-0 blog-image-transition"
            style="
                --blog-image-id: blog-image-<%= singleBlog?.id %>;
                aspect-ratio: 16/9;
            "
            alt="<%= singleBlog?.getString('title') %> image"
            width="896"
            height="504"
            fetchpriority="high"
            decoding="async"
        />
        <% } %>
        <!-- Blog Content -->
        <div class="w-full self-start backdrop-blur-md p-8 rounded-xl">
            <h1
                class="mb-0 font-extrabold sm:text-2xl leading-tight flex md:hidden blog-title-transition"
                style="--blog-title-id: blog-title-<%= singleBlog?.id %>"
            >
                <%= singleBlog?.getString('title') %>
            </h1>
            <!-- Tags -->
            <div class="flex flex-wrap gap-2">
                <% if (isClimbing) { %>
                <% if (singleBlog?.getString('climbType')) { %>
                <a href="/climbing?query=<%= encodeURIComponent(singleBlog.getString('climbType').trim()) %>" class="no-underline">
                    <span class="badge badge-outline badge-lg text-nowrap hover:bg-base-content hover:text-base-100 transition-all duration-200 cursor-pointer">
                        <%= singleBlog.getString('climbType') %>
                    </span>
                </a>
                <% } %>
                <% if (singleBlog?.getString('grade')) { %>
                <a href="/climbing?query=<%= encodeURIComponent(singleBlog.getString('grade').trim()) %>" class="no-underline">
                    <span class="badge badge-outline badge-lg text-nowrap hover:bg-base-content hover:text-base-100 transition-all duration-200 cursor-pointer">
                        <%= singleBlog.getString('grade') %>
                    </span>
                </a>
                <% } %>
                <% if (singleBlog?.getString('style')) { %>
                <a href="/climbing?query=<%= encodeURIComponent(singleBlog.getString('style').trim()) %>" class="no-underline">
                    <span class="badge badge-outline badge-lg text-nowrap hover:bg-base-content hover:text-base-100 transition-all duration-200 cursor-pointer">
                        <%= singleBlog.getString('style') %>
                    </span>
                </a>
                <% } %>
                <% if (singleBlog?.getString('location')) { %>
                <a href="/climbing?query=<%= encodeURIComponent(singleBlog.getString('location').trim()) %>" class="no-underline">
                    <span class="badge badge-outline badge-lg text-nowrap hover:bg-base-content hover:text-base-100 transition-all duration-200 cursor-pointer">
                        <%= singleBlog.getString('location') %>
                    </span>
                </a>
                <% } %>
                <% } else { %>
                <% const pageTags=singleBlog?.getString('tags'); if (pageTags &&
                pageTags.length> 0) { pageTags.split(';').forEach(function(tag)
                { %>
                <% if (tag.trim()) { %>
                <a
                    href="/blog/posts?query=<%= encodeURIComponent(tag.trim()) %>"
                    class="no-underline"
                >
                    <span
                        class="badge badge-outline badge-lg text-nowrap hover:bg-base-content hover:text-base-100 transition-all duration-200 cursor-pointer"
                    >
                        <%= tag.trim() %>
                    </span>
                </a>
                <% } %>
                <% }); %>
                <% } %>
                <% } %>
            </div>

            <div class="text-sm text-base-content">
                <!-- Back to Posts Button -->
                <div class="mt-6">
                    <div class="flex justify-between items-center w-full">
                        <a
                            href="<%= isClimbing ? '/climbing' : '/blog/posts' %>"
                            class="btn btn-outline btn-sm gap-2 transition-all duration-200"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="m12 19-7-7 7-7" />
                                <path d="M19 12H5" />
                            </svg>
                            <%= isClimbing ? 'Back to journal' : 'View all posts' %>
                        </a>
                        <!-- <span>By: <strong>Justin K</strong></span> -->
                        <div class="text-right">
                            <%= isClimbing ? 'Logged' : 'Posted' %>:
                            <strong>
                                <%= formatDateTime(new
                                                                 Date(isClimbing ? singleBlog?.getString('date') : (singleBlog?.getString('manualPublishDate') ||
                                                                 singleBlog?.getString('created')))) %>
                            </strong>
                            <div class="text-right">
                                Updated:
                                <strong>
                                    <%= formatDateTime(new
                                                                     Date(singleBlog?.getString('updated'))) %>
                                </strong>
                            </div>
                        </div>
                    </div>

                    <% const toNoCookie = (s) => (s || '')
                        .replace(/https?:\/\/(www\.)?youtube\.com\/embed\//g, 'https://www.youtube-nocookie.com/embed/')
                        .replace(/<iframe([^>]*?)(?:\s+sandbox="[^"]*")?([^>]*?)>/gi, (match, pre, post) => {
                            const isYT = /youtube(-nocookie)?\.com\/embed\//.test(match);
                            if (!isYT) return match;
                            const stripped = match.replace(/\s+sandbox="[^"]*"/gi, '');
                            const hasAllow = /\ballow=/i.test(stripped);
                            return hasAllow
                                ? stripped
                                : stripped.replace(/<iframe/i, '<iframe allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen');
                        }) %>
                    <% if (isClimbing) { %>
                    <div
                        class="prose max-w-none text-base-content mt-6 min-w-80 font-normal leading-relaxed"
                    >
                        <%- toNoCookie(singleBlog?.getString('content')) %>
                    </div>
                    <% } else { %>
                    <p class="text-base-content min-w-80">
                        <%- toNoCookie(singleBlog?.getString('content1')) %>
                    </p>
                    <p class="text-base-content mb-6 min-w-80">
                        <%- toNoCookie(singleBlog?.getString('content2')) %>
                    </p>
                    <% } %>
                </div>
            </div>
        </div>
    <% } %>
</div>
