<script server>
    const { formatDateTime, getImageUrl } = resolve('../../utils/common')
    const { POCKET_BLOGPOSTS } = resolve('../../utils/constants')

    let singleBlog = null
    let imageUrl = null
    let readingTime = 3
    let tagsList = []
    if (params?.postId) {
        const client = pb({ request })
        try {
            singleBlog = client
                .collection(POCKET_BLOGPOSTS)
                .getFirstListItem(
                    `id = "${params.postId}" && isDeleted = false`,
                    { sort: '-updated' }
                )
            if (!singleBlog) {
                return
            }
            // Update the page title metadata
            const newTitle = `${singleBlog.title} | The Justin Blog`
            data.metadata
                .filter((m) => m.name.includes('title'))
                .forEach((m) => (m.content = newTitle))
            // replace the metadata image as well
            data.metadata
                .filter(
                    (m) => m.name === 'og:image' || m.name === 'twitter:image'
                )
                .forEach((m) => (m.content = getImageUrl(singleBlog)))
            // update the description metadata with the first paragraph of the blog content

            const description =
                singleBlog.content1.match(/<p>(.*?)<\/p>/)[1] ?? ''
            data.metadata
                .filter(
                    (m) =>
                        m.name === 'description' ||
                        m.name === 'og:description' ||
                        m.name === 'twitter:description'
                )
                .forEach((m) => (m.content = description))
        } catch (error) {
            console.error('Error fetching single blog post: ', error)
        }
        //get length of imageUrl
        imageUrl =
            singleBlog?.coverImageAlt?.length == 0
                ? getImageUrl(singleBlog)
                : singleBlog?.coverImageAlt
        const plainOne = singleBlog?.content1
            ? singleBlog.content1.replace(/<[^>]*>/g, ' ')
            : ''
        const plainTwo = singleBlog?.content2
            ? singleBlog.content2.replace(/<[^>]*>/g, ' ')
            : ''
        const totalWords =
            (plainOne + ' ' + plainTwo).trim().split(/\s+/).filter(Boolean)
                .length || 0
        readingTime = Math.max(2, Math.ceil(totalWords / 220))
        tagsList = singleBlog?.tags
            ? singleBlog.tags.split(';').filter((tag) => tag.trim().length > 0)
            : []
    }
</script>
<% if (singleBlog == null) { %>
<%- include('pagenotfound.ejs') %>
<% } else {  %>
<div
    class="grid gap-10 lg:grid-cols-[minmax(0,2.2fr)_minmax(0,1fr)] blog-card-transition"
    style="--blog-card-id: blog-card-<%= singleBlog?.id %>"
>
    <article
        class="glass-panel border border-white/10 p-6 sm:p-10 flex flex-col gap-6"
    >
        <div class="flex flex-wrap items-center justify-between gap-4 text-sm">
            <a
                href="/blog/posts"
                class="btn btn-ghost btn-sm gap-2 border border-white/10"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                </svg>
                Back to posts
            </a>
            <span class="text-base-content/70"
                >Updated
                <strong
                    ><%= formatDateTime(new Date(singleBlog?.updated)) %></strong
                ></span
            >
        </div>
        <h1
            class="text-3xl sm:text-4xl font-semibold leading-tight blog-title-transition"
            style="--blog-title-id: blog-title-<%= singleBlog?.id %>"
        >
            <%= singleBlog?.title %>
        </h1>
        <div
            class="flex flex-wrap gap-2 text-[0.7rem] uppercase text-base-content/60"
        >
            <% if (tagsList?.length) { tagsList.forEach(tag => { %>
            <span class="feature-pill"><%= tag %></span>
            <% }) } else { %>
            <span class="feature-pill">Field Notes</span>
            <% } %>
        </div>
        <% if (imageUrl) { %>
        <div class="relative overflow-hidden">
            <img
                src="<%= imageUrl %>"
                class="h-auto w-full object-cover blog-image-transition"
                style="
                    --blog-image-id: blog-image-<%= singleBlog?.id %>;
                    aspect-ratio: 16/9;
                "
                alt="<%= singleBlog?.title %> image"
            />
            <div
                class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-base-100/90 to-transparent"
            ></div>
        </div>
        <% } %>
        <div class="prose-modern mt-4 space-y-6">
            <div><%- singleBlog?.content1 %></div>
            <div><%- singleBlog?.content2 %></div>
        </div>
        <div
            class="flex flex-wrap items-center justify-between gap-4 pt-4 text-sm"
        >
            <span class="text-base-content/70"
                >Reading time · ~<%= readingTime %>
                min</span
            >
            <a href="/blog/posts" class="btn btn-primary btn-sm gap-2">
                Browse more stories
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </a>
        </div>
    </article>
    <aside class="flex flex-col gap-6">
        <div class="glass-panel border border-white/10 p-6">
            <p class="text-xs uppercase tracking-[0.4em] text-base-content/70">
                Entry Overview
            </p>
            <dl class="mt-4 space-y-4 text-sm">
                <div class="flex items-center justify-between">
                    <dt class="text-base-content/70">Published</dt>
                    <dd class="font-semibold">
                        <%= formatDateTime(new Date(singleBlog?.created ||
                        singleBlog?.updated)) %>
                    </dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-base-content/70">Updated</dt>
                    <dd class="font-semibold">
                        <%= formatDateTime(new Date(singleBlog?.updated)) %>
                    </dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-base-content/70">Reading time</dt>
                    <dd class="font-semibold"><%= readingTime %> min</dd>
                </div>
            </dl>
        </div>
        <div class="glass-panel border border-white/10 p-6">
            <p class="text-xs uppercase tracking-[0.4em] text-base-content/70">
                Tags & themes
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
                <% if (tagsList?.length) { tagsList.forEach(tag => { %>
                <span class="feature-pill"><%= tag %></span>
                <% }) } else { %>
                <span class="feature-pill">Writing</span>
                <% } %>
            </div>
        </div>
    </aside>
</div>
<% } %>
