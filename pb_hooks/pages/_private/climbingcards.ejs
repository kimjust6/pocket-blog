<script server>
    const { formatDateTime, getImageUrl, slugifyTitle } = resolve('../../utils/common')
    const { getClimbingLogs } = resolve('../../utils/pocket')

    const currentPage = parseInt(params?.page) || 1
    const perPage = params?.perPage ?? 6
    const query = params?.query || ""
    const climbType = params?.climbType || ""

    const logs = getClimbingLogs(currentPage, perPage, query, climbType) ?? { items: [], totalPages: 1 }
    const totalPages = logs?.totalPages || 1
    const hasFilters = !!query || !!climbType
</script>

<script>
    var ClimbingApp = {
        searchQuery: decodeURIComponent('<%- encodeURIComponent(params?.query || "").replace(/\'/g, "%27") %>'),
        climbType: decodeURIComponent('<%- encodeURIComponent(params?.climbType || "").replace(/\'/g, "%27") %>'),
        handleSearch() {
            window.location.href = `?query=${encodeURIComponent(this.searchQuery)}&climbType=${encodeURIComponent(this.climbType)}`
        },
        clearSearch() {
            this.searchQuery = ''
            this.climbType = ''
            window.location.href = '/climbing'
        },
        changeType(type) {
            this.climbType = type
            this.handleSearch()
        },
        mounted() {
            if (this.$refs.searchInput) {
                this.$refs.searchInput.focus()
            }
        }
    }
</script>

<div class="bg-base-100 pt-16 flex flex-col justify-between min-h-[calc(100vh-12.54rem)] pb-12">
    <div class="max-w-6xl mx-auto px-4 w-full" v-scope="ClimbingApp" @vue:mounted="mounted">
        <div class="text-center">
            <h1 class="text-5xl font-bold mt-16">
                Climbing Journal
            </h1>
            <p class="mt-4 text-lg text-base-content/80">
                A personal record of sends, failures, and hard-fought projects on the rock and in the gym.
            </p>
            
            <!-- Search bar -->
            <div class="flex justify-center mt-8">
                <div class="relative w-full max-w-xl">
                    <input autofocus v-model="searchQuery" ref="searchInput"
                        class="input w-full border border-gray-600 pr-10" placeholder="Search climbs or locations..."
                        @keydown.enter="handleSearch" />
                    <button v-show="searchQuery" @click="clearSearch"
                        class="absolute right-3 top-1/2 !-translate-y-1/2 btn btn-ghost btn-sm btn-circle active:!-translate-y-1/2"
                        type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="mb-12 text-center">
                <h1 class="text-5xl font-bold">
                    Latest Posts
                </h1>
            </div>
        </div>

        <% if (logs.items.length === 0) { %>
            <div class="text-center py-20 bg-base-200/50 rounded-2xl border border-dashed border-base-content/20">
                <div class="text-6xl mb-4">🧗‍♂️</div>
                <h3 class="text-xl font-semibold mb-2">No climb entries found</h3>
                <p class="text-base-content/60 mb-6">Try adjusting your filters or search keywords.</p>
                <% if (hasFilters) { %>
                    <button @click="clearSearch" class="btn btn-primary btn-sm">Clear Filters</button>
                <% } %>
            </div>
        <% } else { %>
            <!-- Grid list of logs -->
            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                <% logs.items.forEach(log => {
                    const text = log.getString('content').replace(/<[^>]*>/g, '');
                    const imgUrl = getImageUrl(log) || '/climbing-placeholder.png';
                    const climbType = log.getString('climbType');
                    const style = log.getString('style');
                    const grade = log.getString('grade');
                %>
                    <a href="/climbing/<%= encodeURIComponent(slugifyTitle(log.getString('title'))) %>"
                       class="no-underline group"
                       onclick="if(window.gtag) window.gtag('event', 'click', { event_category: 'climbing_log', event_label: decodeURIComponent('<%= encodeURIComponent(log.getString(`title`)) %>') })">
                        <div class="card bg-base-300 backdrop-blur-md shadow-xl transition-shadow duration-300 blog-card-transition"
                             style="--blog-card-id: blog-card-<%= log.id %>">
                            <% if (imgUrl !== null && imgUrl !== "") { %>
                                <figure class="h-auto md:h-48 overflow-hidden m-0 rounded-t-lg">
                                    <img src="<%= imgUrl %>"
                                         alt="<%= log.getString('title') %> Image"
                                         class="w-full h-auto md:h-48 object-cover blog-image-transition rounded-t-lg"
                                         style="--blog-image-id: blog-image-<%= log.id %>"
                                         loading="lazy" />
                                </figure>
                            <% } %>
                            
                            <div class="card-body p-8 gap-0 blog-body-transition">
                                <div class="flex flex-wrap gap-2 pb-4">
                                    <span class="badge badge-outline badge-sm text-nowrap h-auto">
                                        <%= climbType %>
                                    </span>
                                    <% if (grade) { %>
                                        <span class="badge badge-outline badge-sm text-nowrap h-auto">
                                            <%= grade %>
                                        </span>
                                    <% } %>
                                    <% if (style) { %>
                                        <span class="badge badge-outline badge-sm text-nowrap h-auto">
                                            <%= style %>
                                        </span>
                                    <% } %>
                                </div>
                                
                                <h2 class="card-title group-hover:text-primary transition-colors duration-200 mt-0 blog-title-transition"
                                    style="--blog-title-id: blog-title-<%= log.id %>">
                                    <%= log.getString('title') %>
                                </h2>
                                
                                <% if (log.getString('location')) { %>
                                    <div class="flex items-center gap-1 text-xs text-base-content/60 mb-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                        </svg>
                                        <%= log.getString('location') %>
                                    </div>
                                <% } %>
                                
                                <p class="text-sm text-base-content/70 line-clamp-3">
                                    <%= text %>
                                </p>
                                
                                <span class="text-xs text-base-content/50 mt-2">
                                    <%= formatDateTime(new Date(log.getString('date'))) %>
                                </span>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { 
                const queryStr = query ? `&query=${encodeURIComponent(query)}` : '';
                const typeStr = climbType ? `&climbType=${encodeURIComponent(climbType)}` : '';
                const fullParams = `${queryStr}${typeStr}`;
            %>
                <div class="flex justify-center my-12">
                    <div class="join">
                        <% if (currentPage <= 1) { %>
                            <button class="join-item btn btn-sm btn-disabled">«</button>
                        <% } else { %>
                            <a href="?page=<%= currentPage - 1 %><%= fullParams %>" class="join-item btn btn-sm">«</a>
                        <% } %>

                        <% for (let i=1; i <=totalPages; i++) { %>
                            <a href="?page=<%= i %><%= fullParams %>" class="join-item btn btn-sm <%= currentPage === i ? 'btn-active' : '' %>">
                                <%= i %>
                            </a>
                        <% } %>

                        <% if (currentPage >= totalPages) { %>
                            <button class="join-item btn btn-sm btn-disabled">»</button>
                        <% } else { %>
                            <a href="?page=<%= currentPage + 1 %><%= fullParams %>" class="join-item btn btn-sm">»</a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        <% } %>
    </div>
</div>
