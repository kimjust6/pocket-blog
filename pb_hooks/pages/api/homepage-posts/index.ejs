<script server>
  const { getCombinedHomepagePosts, isClimbingRecord } = require(`${__hooks}/pages/utils/pocket.js`)
  const { formatPostViewModel } = require(`${__hooks}/pages/utils/common.js`)

  const page = parseInt(params?.page || '1', 10)
  const perPage = parseInt(params?.perPage || '6', 10)
  const query = params?.query || ''

  const result = getCombinedHomepagePosts(page, perPage, query)

  const formattedItems = (result.items || []).map((blog) => {
      const vm = formatPostViewModel(blog, true, isClimbingRecord(blog))
      return {
          id: vm.id,
          title: vm.title,
          slug: vm.slug,
          link: vm.link,
          text: vm.previewText,
          imageUrl: vm.gridImageUrl,
          date: vm.formattedDate,
          itemIsClimbing: vm.itemIsClimbing,
          badges: (vm.badges || []).map(b => b.text),
          location: vm.location
      }
  })

  response.header('Content-Type', 'application/json')
  response.write(JSON.stringify({
      items: formattedItems,
      page: result.page,
      totalPages: result.totalPages,
      hasMore: page < result.totalPages
  }))
</script>
